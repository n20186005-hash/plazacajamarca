---
// Design reminder: Archivo de Piedra Viva — a calm, factual closing note with source transparency and no commercial positioning.
interface Props { lang: "es" | "en"; homePath: string; }
const { lang, homePath } = Astro.props;
const isSpanish = lang === "es";
const copy = isSpanish
  ? { note: "Esta es una guía independiente, sin fines de lucro, para visitantes. No está afiliada a ninguna entidad gubernamental ni a la administración oficial del lugar.", sources: "La información se contrasta con recursos públicos de la Municipalidad Provincial de Cajamarca, la Dirección Regional de Comercio Exterior y Turismo Cajamarca, MINCETUR y PromPerú. No contiene recomendaciones comerciales.", rights: "Los derechos de cada fotografía pertenecen a su autor. Las imágenes de Wikimedia Commons se muestran con el crédito y la licencia indicados.", legal: "Información legal", privacy: "Privacidad", terms: "Términos", cookies: "Cookies", back: "Volver a la guía", copyright: "© 2026 Guía Plaza de Armas de Cajamarca. Todos los derechos reservados." }
  : { note: "This is an independent, non-profit visitor guide. It is not affiliated with any government entity or the official administration of the site.", sources: "Information is cross-checked against public resources from the Provincial Municipality of Cajamarca, the Regional Directorate of Foreign Trade and Tourism of Cajamarca, MINCETUR and PromPerú. It contains no commercial recommendations.", rights: "Rights to each photograph remain with its photographer. Wikimedia Commons images are shown with the stated credit and license.", legal: "Legal information", privacy: "Privacy", terms: "Terms", cookies: "Cookies", back: "Back to the guide", copyright: "© 2026 Plaza de Armas de Cajamarca Guide. All rights reserved." };
const prefix = isSpanish ? "" : "/en";
---

<footer class="site-footer">
  <div class="footer-mark"><span class="brand-symbol" aria-hidden="true"><svg viewBox="0 0 64 64"><rect width="64" height="64" rx="12" fill="#B84F2B"/><path d="M10 49V28c0-11 10-18 22-18s22 7 22 18v21H43V29c0-5-4-9-11-9s-11 4-11 9v20H10Z" fill="#F4E7CE"/><path d="M16 49V31c0-8 7-14 16-14s16 6 16 14v18h-7V31c0-4-4-7-9-7s-9 3-9 7v18h-7Z" fill="#B84F2B"/></svg><img src="/images/cajamarca-arcade-mark_72c48424.png" alt="" width="42" height="42" onerror="this.style.display='none'" /></span></div>
  <div class="footer-main"><p class="footer-kicker">{copy.legal}</p><p>{copy.note}</p><p>{copy.sources}</p><p>{copy.rights}</p></div>
  <div class="footer-links"><a href={`${prefix}/privacy/`}>{copy.privacy}</a><a href={`${prefix}/terms/`}>{copy.terms}</a><a href={`${prefix}/cookies/`}>{copy.cookies}</a><a href={homePath}>{copy.back}</a></div>
  <p class="copyright">{copy.copyright}</p>
</footer>

<style>
  .brand-symbol { position: relative; display: block; width: 43px; height: 43px; }
  .brand-symbol svg, .brand-symbol img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
</style>
