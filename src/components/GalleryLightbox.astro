---
// Design reminder: Archivo de Piedra Viva — photographs are treated as annotated field plates, with a quiet museum-style lightbox rather than a generic carousel.
interface Props { lang: "es" | "en"; }
const { lang } = Astro.props;
const isSpanish = lang === "es";
const copy = isSpanish
  ? { eyebrow: "Galería de la plaza", title: "Cinco fragmentos para leer el mismo lugar.", intro: "Abra cada fotografía para detenerse en la fuente, las fachadas, la piedra tallada y el cambio de luz que construyen la experiencia de la plaza.", expand: "Ampliar fotografía", close: "Cerrar fotografía", previous: "Fotografía anterior", next: "Fotografía siguiente", source: "Ver licencia", items: [
    { title: "La pileta en primer plano", text: "La fuente octogonal concentra la mirada y revela el trabajo de la piedra tallada en el corazón de la plaza.", src: "/images/cajamarca-fountain-josefito.jpg", alt: "Pileta de piedra de la Plaza de Armas de Cajamarca en primer plano", credit: "Foto: Josefito123 · CC BY-SA 4.0 · Wikimedia Commons", href: "https://commons.wikimedia.org/wiki/File:20250712_111343_Cajamarca.jpg" },
    { title: "La plaza a la luz del día", text: "Una vista amplia permite leer el vacío central, los árboles y las fachadas que enmarcan el recorrido peatonal.", src: "/images/cajamarca-plaza-day-josefito.jpg", alt: "Vista diurna de la Plaza de Armas de Cajamarca", credit: "Foto: Josefito123 · CC BY-SA 4.0 · Wikimedia Commons", href: "https://commons.wikimedia.org/wiki/File:20250712_110718_Cajamarca.jpg" },
    { title: "La plaza al anochecer", text: "Cuando baja la luz, la pileta y las fachadas dibujan otra escala para una caminata pausada por el centro histórico.", src: "/images/cajamarca-plaza-night-wasaberta.jpg", alt: "Pileta y fachadas de la Plaza de Armas de Cajamarca al anochecer", credit: "Foto: Wasaberta · CC BY-SA 4.0 · Wikimedia Commons", href: "https://commons.wikimedia.org/wiki/File:Plaza_de_cajamarca.jpg" },
    { title: "Frente de la Catedral", text: "La fachada de piedra de la Catedral, frente a la plaza, ayuda a reconocer cómo la arquitectura religiosa define uno de sus bordes principales.", src: "/images/cajamarca-cathedral-morrissey.jpg", alt: "Fachada de la Catedral de Cajamarca frente a la plaza", credit: "Foto: morrissey · CC BY 2.0 · Wikimedia Commons", href: "https://commons.wikimedia.org/wiki/File:Catedral_de_Cajamarca.jpg" },
    { title: "Archivo de fachada · 2011", text: "Esta vista de la Catedral de Santa Catalina permite detenerse en los relieves, vanos y ritmos verticales de la arquitectura histórica cajamarquina.", src: "/images/cajamarca-santa-catalina-tehzeta.jpg", alt: "Fachada de la Catedral de Santa Catalina en Cajamarca", credit: "Foto: tehzeta · CC BY-SA 2.0 · Wikimedia Commons", href: "https://commons.wikimedia.org/wiki/File:Iglesia_Santa_Catalina,_Cajamarca.jpg" }
  ] }
  : { eyebrow: "Square gallery", title: "Five fragments for reading the same place.", intro: "Open each photograph to pause over the fountain, facades, carved stone and shifting light that shape the experience of the square.", expand: "Expand photograph", close: "Close photograph", previous: "Previous photograph", next: "Next photograph", source: "View licence", items: [
    { title: "The fountain, close up", text: "The octagonal basin draws the eye and reveals the carved stonework at the square’s centre.", src: "/images/cajamarca-fountain-josefito.jpg", alt: "Stone fountain of Plaza de Armas de Cajamarca seen up close", credit: "Photo: Josefito123 · CC BY-SA 4.0 · Wikimedia Commons", href: "https://commons.wikimedia.org/wiki/File:20250712_111343_Cajamarca.jpg" },
    { title: "The square in daylight", text: "A wider view helps read the open centre, trees and facades that frame the pedestrian walk.", src: "/images/cajamarca-plaza-day-josefito.jpg", alt: "Daytime view of Plaza de Armas de Cajamarca", credit: "Photo: Josefito123 · CC BY-SA 4.0 · Wikimedia Commons", href: "https://commons.wikimedia.org/wiki/File:20250712_110718_Cajamarca.jpg" },
    { title: "The square at dusk", text: "As the light drops, the fountain and facades create another scale for an unhurried walk through the historic centre.", src: "/images/cajamarca-plaza-night-wasaberta.jpg", alt: "Fountain and facades of Plaza de Armas de Cajamarca at dusk", credit: "Photo: Wasaberta · CC BY-SA 4.0 · Wikimedia Commons", href: "https://commons.wikimedia.org/wiki/File:Plaza_de_cajamarca.jpg" },
    { title: "The Cathedral frontage", text: "The stone facade of the Cathedral, facing the square, helps show how religious architecture defines one of its main edges.", src: "/images/cajamarca-cathedral-morrissey.jpg", alt: "Facade of Cajamarca Cathedral facing the square", credit: "Photo: morrissey · CC BY 2.0 · Wikimedia Commons", href: "https://commons.wikimedia.org/wiki/File:Catedral_de_Cajamarca.jpg" },
    { title: "Facade record · 2011", text: "This view of St Catherine’s Cathedral invites a closer look at the reliefs, openings and vertical rhythms of Cajamarca’s historic architecture.", src: "/images/cajamarca-santa-catalina-tehzeta.jpg", alt: "Facade of St Catherine's Cathedral in Cajamarca", credit: "Photo: tehzeta · CC BY-SA 2.0 · Wikimedia Commons", href: "https://commons.wikimedia.org/wiki/File:Iglesia_Santa_Catalina,_Cajamarca.jpg" }
  ] };
---

<section class="gallery-section" aria-labelledby="gallery-title" data-gallery>
  <div class="gallery-heading"><p class="eyebrow">{copy.eyebrow}</p><h2 id="gallery-title">{copy.title}</h2><p>{copy.intro}</p><span class="gallery-plate" aria-hidden="true"><i></i><i></i><i></i><b>CAJ · 07°09′S · {String(copy.items.length).padStart(2, "0")}</b></span></div>
  <div class="gallery-grid">
    {copy.items.map((item, index) => <button class:list={["gallery-item", { "gallery-item-featured": index === 0 }]} type="button" data-gallery-item data-title={item.title} data-text={item.text} data-credit={item.credit} data-href={item.href} aria-label={`${copy.expand}: ${item.title}`}><figure><img src={item.src} alt={item.alt} loading="lazy" /><figcaption><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{item.title}</h3><p>{item.text}</p></div><b aria-hidden="true">↗</b></figcaption></figure></button>)}
  </div>
  <dialog class="lightbox-dialog" data-lightbox aria-labelledby="lightbox-title">
    <div class="lightbox-shell"><button class="lightbox-close" type="button" data-lightbox-close aria-label={copy.close}>×</button><button class="lightbox-nav lightbox-prev" type="button" data-lightbox-previous aria-label={copy.previous}>←</button><figure class="lightbox-figure"><img data-lightbox-image src="" alt="" /><figcaption><span class="eyebrow" data-lightbox-index></span><h2 id="lightbox-title" data-lightbox-title></h2><p data-lightbox-text></p><a data-lightbox-credit href="#" target="_blank" rel="noreferrer"></a></figcaption></figure><button class="lightbox-nav lightbox-next" type="button" data-lightbox-next aria-label={copy.next}>→</button></div>
  </dialog>
</section>

<script is:inline>
  (() => {
    document.querySelectorAll("[data-gallery]").forEach((gallery) => {
      const items = Array.from(gallery.querySelectorAll("[data-gallery-item]"));
      const dialog = gallery.querySelector("[data-lightbox]");
      if (!items.length || !dialog) return;
      const image = dialog.querySelector("[data-lightbox-image]");
      const title = dialog.querySelector("[data-lightbox-title]");
      const text = dialog.querySelector("[data-lightbox-text]");
      const credit = dialog.querySelector("[data-lightbox-credit]");
      const indexLabel = dialog.querySelector("[data-lightbox-index]");
      let activeIndex = 0;
      let returnFocus = null;
      const show = (nextIndex) => {
        activeIndex = (nextIndex + items.length) % items.length;
        const item = items[activeIndex];
        const sourceImage = item.querySelector("img");
        image.src = sourceImage.currentSrc || sourceImage.src;
        image.alt = sourceImage.alt;
        title.textContent = item.dataset.title || "";
        text.textContent = item.dataset.text || "";
        credit.textContent = item.dataset.credit || "";
        credit.href = item.dataset.href || "#";
        indexLabel.textContent = `${String(activeIndex + 1).padStart(2, "0")} / ${String(items.length).padStart(2, "0")}`;
      };
      const open = (nextIndex, trigger) => { returnFocus = trigger; show(nextIndex); if (!dialog.open) dialog.showModal(); };
      items.forEach((item, index) => item.addEventListener("click", () => open(index, item)));
      dialog.querySelector("[data-lightbox-close]").addEventListener("click", () => dialog.close());
      dialog.querySelector("[data-lightbox-previous]").addEventListener("click", () => show(activeIndex - 1));
      dialog.querySelector("[data-lightbox-next]").addEventListener("click", () => show(activeIndex + 1));
      dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
      dialog.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") { event.preventDefault(); show(activeIndex - 1); }
        if (event.key === "ArrowRight") { event.preventDefault(); show(activeIndex + 1); }
      });
      dialog.addEventListener("close", () => { if (returnFocus) returnFocus.focus(); });
    });
  })();
</script>

<style>
  .gallery-section { padding: 125px max(38px, 8vw); background: #f3e6d0; }
  .gallery-heading { display: grid; grid-template-columns: minmax(280px, .9fr) minmax(300px, .72fr); gap: 26px 110px; align-items: end; max-width: 1280px; margin: 0 auto 52px; }
  .gallery-heading .eyebrow { grid-column: 1 / -1; margin-bottom: -4px; }
  .gallery-heading h2 { margin: 0; font-family: var(--serif); font-size: clamp(43px, 4.5vw, 70px); font-weight: 600; letter-spacing: -.055em; line-height: .9; }
  .gallery-heading p:last-child { margin: 0; color: #5c5449; font-size: 17px; }
  .gallery-plate { display: flex; grid-column: 1 / -1; align-items: end; gap: 3px; width: fit-content; padding-top: 4px; color: var(--terracotta-dark); font-size: 9px; font-weight: 700; letter-spacing: .14em; }
  .gallery-plate i { display: block; width: 13px; height: 19px; border: 1px solid var(--terracotta); border-bottom: 0; border-radius: 13px 13px 0 0; }
  .gallery-plate b { margin-left: 8px; font-weight: 700; }
  .gallery-grid { display: grid; grid-template-columns: 1.23fr .77fr; gap: 20px; max-width: 1280px; margin: 0 auto; }
  .gallery-item { min-width: 0; padding: 0; border: 0; background: transparent; color: var(--ink); cursor: zoom-in; text-align: left; }
  .gallery-item-featured { grid-row: span 2; }
  .gallery-item figure { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: 1fr auto; height: 100%; margin: 0; overflow: hidden; background: var(--paper); box-shadow: 0 14px 35px rgba(75, 54, 37, .1); }
  .gallery-item img { display: block; grid-area: 1 / 1; width: 100%; height: 100%; min-height: 265px; object-fit: cover; filter: saturate(.86) contrast(1.04); transition: transform .45s var(--ease), filter .45s var(--ease); }
  .gallery-item-featured img { min-height: 565px; }
  .gallery-item figcaption { display: grid; grid-template-columns: 30px 1fr auto; gap: 11px; align-items: start; padding: 18px 20px 19px; background: var(--paper); transition: background .25s var(--ease); }
  .gallery-item figcaption > span { color: var(--terracotta); font-family: var(--serif); font-size: 22px; font-weight: 700; line-height: 1; }
  .gallery-item h3 { margin: 0 0 4px; font-family: var(--serif); font-size: 25px; font-weight: 600; letter-spacing: -.025em; line-height: 1; }
  .gallery-item p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.4; }
  .gallery-item b { color: var(--terracotta-dark); font-size: 20px; font-weight: 400; line-height: 1; transition: transform .25s var(--ease); }
  .gallery-item:hover img { filter: saturate(1) contrast(1.07); transform: scale(1.035); }
  .gallery-item:hover figcaption { background: #fffaf0; }
  .gallery-item:hover b { transform: translate(3px, -3px); }
  .lightbox-dialog { width: min(1120px, calc(100vw - 34px)); max-width: none; padding: 0; border: 0; background: #211f1b; color: #fffaf0; box-shadow: 0 30px 100px rgba(0,0,0,.52); }
  :global(.lightbox-dialog::backdrop) { background: rgba(25, 23, 20, .82); backdrop-filter: blur(5px); }
  .lightbox-shell { display: grid; grid-template-columns: 54px minmax(0, 1fr) 54px; align-items: center; position: relative; min-height: min(720px, 87vh); }
  .lightbox-figure { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(240px, .55fr); align-items: stretch; max-height: 87vh; margin: 0; }
  .lightbox-figure img { display: block; width: 100%; height: min(680px, 87vh); object-fit: contain; background: #151412; }
  .lightbox-figure figcaption { display: flex; flex-direction: column; justify-content: flex-end; padding: 38px 32px 36px; background: #2e2a25; }
  .lightbox-figure .eyebrow { color: #efb28c; margin-bottom: 16px; }
  .lightbox-figure h2 { margin: 0 0 18px; font-family: var(--serif); font-size: clamp(34px, 4vw, 52px); font-weight: 600; letter-spacing: -.05em; line-height: .92; }
  .lightbox-figure p { color: #e6d7c7; font-size: 15px; }
  .lightbox-figure a { margin-top: 16px; color: #f4c4a5; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
  .lightbox-close,.lightbox-nav { display: grid; place-items: center; padding: 0; border: 0; background: transparent; color: #fffaf0; cursor: pointer; transition: color .18s var(--ease), transform .18s var(--ease); }
  .lightbox-close:hover,.lightbox-nav:hover { color: #efb28c; transform: scale(1.08); }
  .lightbox-close { position: absolute; z-index: 2; top: 14px; right: 14px; width: 38px; height: 38px; border: 1px solid rgba(255,250,240,.4); border-radius: 50%; font-size: 28px; line-height: 1; }
  .lightbox-nav { width: 54px; height: 54px; font-size: 29px; }
  @media (max-width: 820px) { .gallery-section { padding: 88px 25px; } .gallery-heading { grid-template-columns: 1fr; gap: 20px; margin-bottom: 36px; } .gallery-heading .eyebrow, .gallery-plate { grid-column: auto; } .gallery-grid { grid-template-columns: 1fr; } .gallery-item-featured { grid-row: auto; } .gallery-item-featured img { min-height: 410px; } .lightbox-dialog { width: min(720px, calc(100vw - 22px)); } .lightbox-shell { grid-template-columns: 40px minmax(0, 1fr) 40px; min-height: 0; } .lightbox-nav { width: 40px; font-size: 23px; } .lightbox-figure { grid-template-columns: 1fr; max-height: 92vh; } .lightbox-figure img { height: min(61vh, 520px); } .lightbox-figure figcaption { padding: 22px 23px 24px; } .lightbox-figure h2 { font-size: 37px; } .lightbox-figure p { margin-bottom: 0; } }
</style>
