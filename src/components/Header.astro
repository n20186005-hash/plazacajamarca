---
// Design reminder: Archivo de Piedra Viva — a compact archival masthead with a terracotta three-arch seal.
interface Props {
  lang: "es" | "en";
  alternatePath: string;
  homePath: string;
}
const { lang, alternatePath, homePath } = Astro.props;
const isSpanish = lang === "es";
const labels = isSpanish
  ? { guide: "Guía editorial independiente", nav: "Explorar", practical: "Visita", map: "Mapa", faq: "Preguntas", language: "English", menu: "Abrir navegación" }
  : { guide: "Independent editorial guide", nav: "Explore", practical: "Visit", map: "Map", faq: "FAQ", language: "Español", menu: "Open navigation" };
---

<header class="site-header">
  <div class="masthead">
    <a class="brand" href={homePath} aria-label={isSpanish ? "Inicio de la Guía Plaza de Armas de Cajamarca" : "Plaza de Armas de Cajamarca Guide home"}>
      <span class="brand-symbol" aria-hidden="true"><svg viewBox="0 0 64 64"><rect width="64" height="64" rx="12" fill="#B84F2B"/><path d="M10 49V28c0-11 10-18 22-18s22 7 22 18v21H43V29c0-5-4-9-11-9s-11 4-11 9v20H10Z" fill="#F4E7CE"/><path d="M16 49V31c0-8 7-14 16-14s16 6 16 14v18h-7V31c0-4-4-7-9-7s-9 3-9 7v18h-7Z" fill="#B84F2B"/></svg><img src="/images/cajamarca-arcade-mark.png" alt="" width="50" height="50" onerror="this.style.display='none'" /></span>
      <span class="brand-copy"><strong>Plaza de Armas</strong><small>{labels.guide}</small></span>
    </a>
    <nav class="main-nav" aria-label={labels.menu}>
      <a href="#historia">{labels.nav}</a>
      <a href="#visita">{labels.practical}</a>
      <a href="#mapa">{labels.map}</a>
      <a href="#preguntas">{labels.faq}</a>
    </nav>
    <a class="language-link" href={alternatePath} lang={isSpanish ? "en" : "es"}>{labels.language}<span aria-hidden="true">↗</span></a>
  </div>
</header>

<style>
  .brand { gap: 14px; }
  .brand-symbol { position: relative; display: block; width: 51px; height: 51px; flex: 0 0 51px; }
  .brand-symbol svg, .brand-symbol img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .brand-copy strong { font-size: 28px; }
  .brand-copy small { color: var(--terracotta-dark); font-size: 9px; letter-spacing: .17em; }
  :global(.footer-mark .brand-symbol) { width: 43px; height: 43px; flex-basis: 43px; }
</style>
