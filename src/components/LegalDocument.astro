---
// Design reminder: Archivo de Piedra Viva — legal content remains calm, fully readable and visually connected to the main guide.
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import CookieBanner from "./CookieBanner.astro";
type LegalKind = "privacy" | "terms" | "cookies";
interface Props { lang: "es" | "en"; kind: LegalKind; }
const { lang, kind } = Astro.props;
const isSpanish = lang === "es";
const root = isSpanish ? "/" : "/en/";
const alternatePath = isSpanish ? `/en/${kind}/` : `/${kind}/`;
const documents = isSpanish ? {
  privacy: { title: "Política de privacidad", description: "Política de privacidad de la Guía Plaza de Armas de Cajamarca.", updated: "Última actualización: agosto de 2026", intro: "Esta guía independiente y sin fines de lucro aplica el principio de mínima recopilación: solo tratamos los datos necesarios para mantener, proteger y comprender el uso general del sitio.", sections: [["Información que podemos recopilar", "Podemos recibir datos técnicos de navegación, como dirección IP, tipo de navegador y páginas visitadas; información de cookies y tecnologías similares; y cualquier dato que una persona comparta voluntariamente mediante un canal de contacto."], ["Cómo usamos la información", "Usamos estos datos para mejorar la claridad del contenido y la experiencia de navegación, analizar patrones de uso de forma agregada, responder solicitudes y cumplir obligaciones legales aplicables."], ["Servicios de terceros", "El sitio puede mostrar Google Maps para la ubicación y puede activar Google Analytics únicamente tras su consentimiento de cookies analíticas. Estos servicios aplican sus propias políticas. Las fotografías enlazan a sus respectivas fichas de licencia cuando corresponde."], ["Sus derechos", "Según las normas aplicables, incluidas las disposiciones pertinentes del RGPD cuando resulten aplicables, puede solicitar acceso, rectificación o eliminación de datos personales; oponerse a determinados tratamientos; y presentar una reclamación ante la autoridad competente."], ["Contacto y alcance", "No vendemos datos personales ni ofrecemos un servicio de reserva. Esta guía no es una entidad oficial del destino. Para solicitudes relacionadas con datos, use los datos de contacto publicados en el canal que utilice esta guía."]] },
  terms: { title: "Términos de uso", description: "Términos de uso de la Guía Plaza de Armas de Cajamarca.", updated: "Última actualización: agosto de 2026", intro: "Al acceder y usar esta guía, acepta estos términos. El sitio ofrece información general para apoyar una planificación prudente; no sustituye las verificaciones oficiales ni la decisión individual de cada visitante.", sections: [["Uso del contenido", "Todo el contenido se proporciona exclusivamente con fines informativos. La guía es una iniciativa independiente de información turística y no está afiliada a la Plaza de Armas de Cajamarca, a organismos públicos ni a operadores comerciales."], ["Exactitud de la información", "Procuramos usar fuentes públicas y describir las incertidumbres, pero no garantizamos que toda la información sea completa, continua o actual. Las rutas, condiciones, servicios y actividades pueden cambiar. Verifique siempre los asuntos importantes con fuentes oficiales antes de viajar."], ["Propiedad intelectual", "El diseño y los textos originales están protegidos por los derechos que correspondan. Los créditos y licencias de fotografías de Wikimedia Commons se indican junto a las imágenes o en el apartado de créditos. Google Maps se utiliza conforme a sus condiciones de servicio."], ["Limitación de responsabilidad", "El sitio se proporciona tal como está, sin garantías. No asumimos responsabilidad por pérdidas, daños o decisiones de viaje derivadas del uso de esta información."], ["Cambios", "Podemos ajustar el contenido o estos términos cuando sea necesario. La fecha de actualización indica la versión vigente de esta página."]] },
  cookies: { title: "Ajustes de cookies", description: "Gestione las preferencias de cookies para la Guía Plaza de Armas de Cajamarca.", updated: "Última actualización: agosto de 2026", intro: "Usamos cookies para que el sitio funcione y, cuando usted lo permite, para comprender de manera agregada cómo se usa la guía. Puede cambiar sus preferencias en cualquier momento desde esta página.", sections: [["Cookies necesarias", "Son esenciales para el funcionamiento básico y para recordar una elección de consentimiento. No se utilizan para publicidad personalizada."], ["Cookies analíticas", "Si las acepta, activamos Google Analytics con el identificador de medición G-HXM22WWPKP para analizar patrones de uso de manera agregada. Puede rechazar esta categoría sin perder el acceso al contenido principal."], ["Cookies de preferencias", "Pueden recordar configuraciones del sitio, como la elección de consentimiento. No se usan para elaborar perfiles publicitarios."], ["Cookies de marketing", "Esta guía no activa cookies de marketing ni publicidad personalizada."], ["Gestión del consentimiento", "Sus preferencias se guardan localmente en este navegador. Si borra los datos de navegación, es posible que deba elegir de nuevo. Desactivar algunas categorías puede afectar funciones no esenciales."]] }
} : {
  privacy: { title: "Privacy policy", description: "Privacy policy for the Plaza de Armas de Cajamarca Guide.", updated: "Last updated: August 2026", intro: "This independent, non-profit guide follows a data-minimisation principle: we process only what is needed to maintain, protect and understand general use of the site.", sections: [["Information we may collect", "We may receive technical browsing data such as IP address, browser type and pages viewed; information from cookies and similar technologies; and information a person voluntarily shares through a contact channel."], ["How we use information", "We use this information to improve content clarity and browsing experience, analyse aggregated usage patterns, answer requests and meet applicable legal obligations."], ["Third-party services", "The site may display Google Maps for location and may enable Google Analytics only after consent to analytics cookies. Those services apply their own policies. Photographs link to their respective licence pages where applicable."], ["Your rights", "Under applicable rules, including relevant GDPR provisions when they apply, you may request access to, correction or deletion of personal data; object to certain processing; and complain to the competent authority."], ["Contact and scope", "We do not sell personal data or offer a booking service. This guide is not an official destination body. For data-related requests, use the contact details published through the channel used by this guide."]] },
  terms: { title: "Terms of use", description: "Terms of use for the Plaza de Armas de Cajamarca Guide.", updated: "Last updated: August 2026", intro: "By accessing and using this guide, you agree to these terms. The site provides general information to support careful planning; it does not replace official checks or each visitor’s personal judgement.", sections: [["Using the content", "All content is provided for information only. This guide is an independent visitor-information initiative and is not affiliated with Plaza de Armas de Cajamarca, public authorities or commercial operators."], ["Accuracy of information", "We aim to use public sources and describe uncertainties, but do not guarantee that every detail is complete, continuous or current. Routes, conditions, services and activities can change. Always verify important matters through official sources before travelling."], ["Intellectual property", "The design and original text are protected by applicable rights. Credits and licences for Wikimedia Commons photographs appear beside the images or in the credits section. Google Maps is used under its terms of service."], ["Limitation of liability", "The site is provided as is, without warranties. We accept no responsibility for losses, damages or travel decisions resulting from use of this information."], ["Changes", "We may adjust content or these terms when necessary. The update date identifies the current version of this page."]] },
  cookies: { title: "Cookie settings", description: "Manage cookie preferences for the Plaza de Armas de Cajamarca Guide.", updated: "Last updated: August 2026", intro: "We use cookies so the site works and, when you allow it, to understand in aggregate how the guide is used. You can change your choices at any time on this page.", sections: [["Necessary cookies", "These are essential for basic operation and for remembering a consent choice. They are not used for personalised advertising."], ["Analytics cookies", "If you accept them, we enable Google Analytics with measurement ID G-HXM22WWPKP to analyse aggregate usage patterns. You can reject this category without losing access to core content."], ["Preference cookies", "These may remember site settings, including your consent choice. They are not used to create advertising profiles."], ["Marketing cookies", "This guide does not enable marketing cookies or personalised advertising."], ["Managing consent", "Your choices are stored locally in this browser. If you clear browsing data, you may need to choose again. Disabling some categories may affect non-essential functions."]] }
};
const doc = documents[kind];
const controls = isSpanish ? { accept: "Aceptar analíticas", reject: "Rechazar todo salvo lo necesario", saved: "Las preferencias se guardan en este navegador." } : { accept: "Accept analytics", reject: "Reject all but necessary", saved: "Preferences are saved in this browser." };
---

<BaseLayout title={`${doc.title} | ${isSpanish ? "Guía Plaza de Armas de Cajamarca" : "Plaza de Armas de Cajamarca Guide"}`} description={doc.description} lang={lang} alternatePath={alternatePath}>
  <Header lang={lang} alternatePath={alternatePath} homePath={root} />
  <main class="legal-main"><article class="legal-document"><p class="eyebrow">{isSpanish ? "Información de la guía" : "Guide information"}</p><h1>{doc.title}</h1><p class="legal-updated">{doc.updated}</p><p class="legal-lead">{doc.intro}</p>{doc.sections.map(([heading, body], index) => <section><span>{String(index + 1).padStart(2, "0")}</span><div><h2>{heading}</h2><p>{body}</p></div></section>)}{kind === "cookies" && <aside class="cookie-settings"><p>{controls.saved}</p><div><button class="text-button" type="button" data-cookie-action="reject">{controls.reject}</button><button class="seal-button" type="button" data-cookie-action="accept">{controls.accept}</button></div></aside>}</article></main>
  <Footer lang={lang} homePath={root} />
  <CookieBanner lang={lang} />
</BaseLayout>
