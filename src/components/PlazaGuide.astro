---
<BaseLayout title={t.title} description={t.description} lang={lang} alternatePath={alternatePath} structuredData={[sourceData, faqData]}>
<Header lang={lang} alternatePath={alternatePath} homePath={root} />
<main>
<section class="hero" aria-labelledby="hero-title"><img class="hero-photo" src="/images/cajamarca-plaza-night-wasaberta.jpg" alt={isSpanish ? "Plaza de Armas de Cajamarca - Vista principal del atardecer en Cajamarca, Perú" : "Plaza de Armas de Cajamarca - Main dusk view in Cajamarca, Peru"} loading="eager" /><div class="hero-overlay"></div><div class="hero-rule" aria-hidden="true"></div><div class="hero-content"><p class="eyebrow light">{t.eyebrow}</p><h1 id="hero-title">{t.hero}</h1><p class="hero-deck">{t.intro}</p><div class="hero-actions"><a class="seal-button light-seal" href="#mapa">{t.route}<span aria-hidden="true">↓</span></a><a class="source-link light-link" href={inventoryUrl} target="_blank" rel="noreferrer">{t.source}<span aria-hidden="true">↗</span></a></div></div><p class="hero-credit"><a href={nightCommonsUrl} target="_blank" rel="noreferrer">{isSpanish ? "Foto: Wasaberta · CC BY-SA 4.0" : "Photo: Wasaberta · CC BY-SA 4.0"}</a></p></section>
<section class="field-strip" aria-label={t.lead}><div class="strip-label"><span class="section-number">00</span><span>{t.lead}</span></div><dl class="field-facts">{t.tiles.map(([term, value]) => <div><dt>{term}</dt><dd>{value}</dd></div>)}</dl></section>
<WeatherWidget lang={lang} />
<section class="reading-section" id="historia" aria-labelledby="history-title"><div class="vertical-guide" aria-hidden="true"><span>CAJAMARCA · 07°09′S</span></div><div class="story-copy"><p class="eyebrow">{t.contextKicker}</p><h2 id="history-title">{t.contextTitle}</h2><p>{t.p1} <a class="inline-source" href={inventoryUrl} target="_blank" rel="noreferrer">MINCETUR ↗</a></p><p>{t.p2} <a class="inline-source" href={promPeruUrl} target="_blank" rel="noreferrer">PromPerú ↗</a></p><p>{t.p3}</p><aside class="heritage-note"><img src="/images/cajamarca-orientation-seal.png" alt="" /><div><span>{t.monument}</span><p>{t.monumentText}</p></div></aside></div><figure class="day-photo"><img src="/images/cajamarca-plaza-day-josefito.jpg" alt={isSpanish ? "Plaza de Armas de Cajamarca - Vista diurna de la plaza en Cajamarca, Perú" : "Plaza de Armas de Cajamarca - Daytime view of the square in Cajamarca, Peru"} loading="lazy" /><figcaption>{t.photoCaption} <a href={commonsUrl} target="_blank" rel="noreferrer">{t.readMore} ↗</a></figcaption></figure></section>
<GalleryLightbox lang={lang} />
<section class="observation-section" aria-labelledby="observe-title"><div class="section-intro"><p class="eyebrow">{t.portraitTitle}</p><h2 id="observe-title">{t.observe}</h2><p class="orientation-note">{isSpanish ? "Punto de orientación · observe estas claves antes de continuar el recorrido." : "Orientation point · consider these cues before continuing your walk."}</p></div><div class="observation-list">{t.cues.map(([number, title, text]) => <article class="observation"><span>{number}</span><h3>{title}</h3><p>{text}</p></article>)}</div><img class="route-ornament" src="/images/cajamarca-route-ornament.png" alt="" loading="lazy" /></section>
<section class="visit-section" id="visita" aria-labelledby="visit-title"><div class="visit-heading"><p class="eyebrow">{t.visitKicker}</p><h2 id="visit-title">{t.visitTitle}</h2><p>{t.visitIntro}</p></div><div class="visit-grid"><article class="arrival-panel"><h3>{t.arrival}</h3>{t.arrivals.map(([title, text], index) => <details open={index === 0}><summary>{title}<span aria-hidden="true">+</span></summary><p>{text}</p></details>)}</article><div class="visit-notes"><article><span class="note-index">A</span><h3>{t.fee}</h3><p>{t.feeText}</p><a class="source-link" href={inventoryUrl} target="_blank" rel="noreferrer">MINCETUR <span aria-hidden="true">↗</span></a></article><article><span class="note-index">B</span><h3>{t.time}</h3><p>{t.timeText}</p></article></div></div></section>
<section class="services-section" aria-labelledby="services-title"><div class="service-heading"><p class="eyebrow">{t.services}</p><h2 id="services-title">{t.serviceTitle}</h2><p>{t.serviceIntro}</p></div><div class="service-grid">{t.serviceItems.map(([title, text], index) => <article><span>{String(index + 1).padStart(2, "0")}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
<section class="food-section" aria-labelledby="food-title"><div class="food-print" aria-hidden="true"></div><div><p class="eyebrow">{t.foodKicker}</p><h2 id="food-title">{t.foodTitle}</h2></div><p>{t.foodText}</p></section>
<section class="nearby-section" aria-labelledby="nearby-title"><div class="nearby-title"><p class="eyebrow">{t.nearbyKicker}</p><h2 id="nearby-title">{t.nearbyTitle}</h2><p class="nearby-intro" set:html={t.nearbyIntro}></p></div><ol class="nearby-list">{t.nearby.map(([name, text], index) => <li><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{name}</h3><p>{text}</p></div></li>)}</ol></section>
<section class="map-section" id="mapa" aria-labelledby="map-title"><div class="map-info"><p class="eyebrow">{t.mapKicker}</p><h2 id="map-title">{t.mapTitle}</h2><p>{t.mapText}</p><a class="seal-button" href="https://maps.app.goo.gl/ESWMHyuaU6USorAt6" target="_blank" rel="noreferrer">{t.mapLink}<span aria-hidden="true">↗</span></a><p class="map-gov-note" set:html={t.mapGovNote}></p></div><div class="map-frame"><iframe title={isSpanish ? "Mapa de Plaza de Armas de Cajamarca" : "Map of Plaza de Armas de Cajamarca"} src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3958.7362544735934!2d-78.5198635730413!3d-7.156461742848036!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x91b25af91f263ceb%3A0xd69ad6c71bdf9075!2z5Y2h5ZOI6ams5Y2h5q2m5Zmo5bm_5Zy6!5e0!3m2!1ses!2spe!4v1787824774226!5m2!1ses!2spe" width="100%" height="450" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></section>
<section class="faq-section" id="preguntas" aria-labelledby="faq-title"><div class="faq-intro"><p class="eyebrow">{t.faqKicker}</p><h2 id="faq-title">{t.faqTitle}</h2><img src="/images/cajamarca-stone-rubbing.png" alt="" loading="lazy" /></div><div class="faq-list">{t.faqs.map(([question, answer], index) => <details open={index === 0}><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
<section class="credits-section"><p><strong>{t.creditsTitle}.</strong> {t.creditText} <a href={nightCommonsUrl} target="_blank" rel="noreferrer">{t.readMore} ↗</a></p><p><strong>{t.cookieTitle}.</strong> {t.cookieText} <a href={isSpanish ? "/cookies/" : "/en/cookies/"}>{t.cookieLink} →</a></p></section>
</main><Footer lang={lang} homePath={root} /><CookieBanner lang={lang} />
</BaseLayout>

<style>
  .orientation-note { max-width: 420px; margin: 19px 0 0; color: #e7d6c5; font-size: 14px; line-height: 1.45; }
</style>
