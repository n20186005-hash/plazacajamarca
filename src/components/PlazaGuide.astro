// Design reminder: Archivo de Piedra Viva — a non-commercial walking narrative with real photographs, stone textures, and practical evidence.
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import CookieBanner from "./CookieBanner.astro";
import WeatherWidget from "./WeatherWidget.astro";
import GalleryLightbox from "./GalleryLightbox.astro";
interface Props { lang: "es" | "en"; }
const { lang } = Astro.props;
const isSpanish = lang === "es";
const root = isSpanish ? "/" : "/en/";
const alternatePath = isSpanish ? "/en/" : "/";
const t = isSpanish ? {
title: "Plaza de Armas de Cajamarca (Cajamarca) - Guía del visitante y ubicación", description: "Descubre la Plaza de Armas de Cajamarca, el ícono histórico del centro de Cajamarca, Cajamarca, Perú. Consulta mapa de ubicación, horarios, alrededores como la Catedral de Cajamarca y Cuarto del Rescate, y consejos de visita.", eyebrow: "Centro histórico · Cajamarca, Perú", hero: "La plaza donde la piedra guarda la memoria.", intro: "Bienvenido a la **Plaza de Armas de Cajamarca**, reconocida como la **Plaza de Armas of Cajamarca** del corazón urbano. Ubicada en el centro de **Cajamarca**, **Cajamarca**, **Perú** (Plaza de Armas de Cajamarca → Cajamarca → Cajamarca → Perú), esta guía ofrece contexto histórico, orientación práctica y respeto por un espacio público vivo.", route: "Abrir mapa y ruta", source: "Ver fuente pública", lead: "Antes de ir", tiles: [["Acceso", "Libre"], ["Referencia de horario", "24 horas"], ["Altitud", "2.722 m"], ["Punto de mapa", "-7.1565, -78.5199"]], photoCaption: "Vista de la Plaza de Armas de Cajamarca. Foto: Josefito123, CC BY-SA 4.0, vía Wikimedia Commons.", contextKicker: "Una plaza para leer caminando", contextTitle: "La forma de una plaza, el peso de una historia (Sobre la Plaza de Armas de Cajamarca).", p1: "Acerca de la Plaza de Armas de Cajamarca: ocupa el centro histórico de Cajamarca, Cajamarca, Perú (Plaza de Armas de Cajamarca → Cajamarca → Cajamarca → Perú). El inventario turístico nacional la clasifica como manifestación cultural y lugar histórico; registra una planta cuadrangular, una superficie neta de 12.139 m² y una altitud de 2.722 metros.", p2: "Este espacio está vinculado al encuentro de 1532 entre las fuerzas de Francisco Pizarro y el inca Atahualpa. La lectura histórica exige cuidado: no es un decorado inmóvil, sino un espacio urbano que reúne memoria andina, período colonial y vida cotidiana actual.", p3: "En el centro permanece la pileta labrada: una fuente octogonal de piedra que las fuentes públicas sitúan a fines del siglo XVII. Mire las proporciones de su base, la relación con las fachadas y el cambio de luz antes de apresurar la visita.", monument: "Dato patrimonial", monumentText: "La pileta fue declarada Monumento Histórico por resolución estatal en 1972, según la ficha oficial de inventario.", portraitTitle: "Tres pistas para observar", observe: "Deje que el recorrido vaya despacio.", cues: [["01", "La fuente", "La pileta octogonal organiza visualmente el vacío central."], ["02", "Los bordes", "Templos, fachadas y recorridos peatonales definen el perímetro de la plaza."], ["03", "El uso diario", "La plaza es un espacio público: dé prioridad al paso, al descanso y a las actividades locales."]], visitKicker: "Orientación práctica", visitTitle: "Llegar, recorrer y resolver lo esencial (Ubicación y cómo visitar la Plaza de Armas of Cajamarca en Cajamarca).", visitIntro: "La Plaza de Armas de Cajamarca se ubica en el centro de la ciudad de Cajamarca, Cajamarca, Perú. Las condiciones de tráfico, paraderos, estacionamiento y apertura de servicios cambian; confirme lo relevante el mismo día de su recorrido.", arrival: "Cómo llegar", arrivals: [["Desde el aeropuerto", "Al llegar al aeropuerto de Cajamarca, un taxi autorizado o transporte previamente coordinado puede conectar con el centro urbano. Solicite al conductor que confirme el punto de descenso y el estado del tránsito antes de salir."], ["Desde el terminal o la ciudad", "Los buses interurbanos llegan a la ciudad; desde las zonas de llegada, continúe en taxi, transporte urbano o a pie según su ubicación, equipaje y horario. No se recomienda cruzar calzadas con equipaje sin usar pasos adecuados."], ["En taxi o vehículo", "Use como referencia “Plaza de Armas de Cajamarca”. La llegada en vehículo requiere atención a restricciones, peatones y cierres temporales del centro. No se indica un estacionamiento concreto porque la disponibilidad varía."], ["A pie", "El inventario turístico ubica el recurso en el centro de la ciudad y registra el acceso peatonal como tramo inmediato. Camine por rutas iluminadas, especialmente si visita al anochecer."]], fee: "Entrada y costos", feeText: "La ficha pública de MINCETUR registra ingreso libre y una referencia de acceso durante las 24 horas. La plaza es un espacio público: no hay una tarifa de admisión indicada para recorrerla. Los costos de traslado, estacionamiento, compras y actividades privadas se gestionan por separado.", time: "Mejor momento y duración", timeText: "Para apreciar las fachadas y mantener un paso cómodo, prefiera la mañana o el final de la tarde; ajuste la visita al clima y a la actividad local. Reserve entre 30 y 60 minutos para la plaza y más tiempo si continúa por el centro histórico.", services: "Servicios alrededor", serviceTitle: "Lo útil, sin convertir la visita en publicidad.", serviceIntro: "Esta guía describe tipos de servicio, no recomienda negocios. El inventario oficial registra oferta de alojamiento y alimentación en la plaza y en la ciudad, junto con bancos, taxis, comercios de abastecimiento y estaciones de servicio urbanas.", serviceItems: [["Baños y agua", "Pregunte por servicios públicos o de consumo en los establecimientos cercanos; la disponibilidad y las condiciones de uso pueden variar."], ["Estacionamiento", "Considere opciones autorizadas fuera de la calzada. Confirme horarios, capacidad y normas antes de dejar un vehículo."], ["Comida", "En el centro se encuentran restaurantes, cafeterías, kioscos y otros formatos de alimentación. Elija según sus necesidades y confirme alérgenos directamente."], ["Descanso y compras", "La ciudad ofrece hoteles, hostales, comercios de barrio y cajeros. Planifique el alojamiento y retire efectivo solo en puntos seguros."], ["Combustible y carga", "Las estaciones de servicio se localizan en la ciudad, no en la experiencia peatonal de la plaza. Verifique la ruta y compatibilidad de su vehículo antes de desplazarse."], ["Accesibilidad", "El piso, los bordes y la actividad urbana pueden afectar el desplazamiento. Si requiere una condición específica de accesibilidad, confirme por canales oficiales antes de la visita."]], foodKicker: "Comer cerca, con criterio", foodTitle: "Una guía de tipos, no de marcas.", foodText: "En el entorno urbano de Cajamarca se registran restaurantes, cafeterías, kioscos y fuentes de soda. Para mantener independencia editorial, esta guía no clasifica ni promociona comercios. Busque opciones acordes a su presupuesto, dieta y tiempo disponible, y consulte directamente los ingredientes, métodos de pago y horarios.", nearbyKicker: "Continuar el recorrido", nearbyTitle: "Hitos para enlazar con la plaza (Hitos y atractivos alrededor de Plaza de Armas of Cajamarca).", nearbyIntro: "Al visitar la Plaza de Armas de Cajamarca, los visitantes pueden explorar con facilidad hitos históricos y puntos de interés de los alrededores, entre ellos la **Catedral de Cajamarca** y el **Cuarto del Rescate**.", nearby: [["Catedral de Cajamarca", "Templo frente a la plaza y una referencia visual central del conjunto histórico."], ["Iglesia de San Francisco", "Arquitectura religiosa que ayuda a leer el borde urbano de la plaza."], ["Cuarto del Rescate", "Sitio históricamente asociado a Atahualpa; confirme condiciones de acceso antes de ir."], ["Cerro Santa Apolonia", "Punto alto urbano para observar la relación entre la ciudad y el paisaje."], ["Baños del Inca", "Zona conocida por sus aguas termales, fuera de la caminata inmediata de la plaza."]], mapKicker: "Ubicación", mapTitle: "Sitúe su visita en el centro de Cajamarca (Ubicación y mapa de Plaza de Armas de Cajamarca).", mapText: "El mapa se presenta en español, idioma local de la zona. Úselo como orientación; para decisiones de ruta en tiempo real, confirme condiciones de tránsito y accesos en el servicio cartográfico.", mapLink: "Abrir la ubicación en Google Maps", mapGovNote: "Para actualizaciones oficiales e información turística regional, visite el <a href=\"http://consultasenlinea.mincetur.gob.pe/fichaInventario/index.aspx?cod_Ficha=2432\" target=\"_blank\" rel=\"noopener noreferrer\">Portal Oficial de Turismo de MINCETUR · Perú / Cajamarca</a>.", faqKicker: "Preguntas frecuentes", faqTitle: "Respuestas breves para planificar con prudencia (Preguntas sobre Plaza de Armas de Cajamarca).", faqs: [["¿La Plaza de Armas de Cajamarca tiene entrada?", "La ficha de MINCETUR registra ingreso libre. El espacio es una plaza pública; los servicios privados del entorno se gestionan por separado."], ["¿Está abierta todo el día?", "El inventario público la registra con referencia de acceso durante las 24 horas. Eventos, obras, seguridad y condiciones locales pueden modificar la experiencia, por lo que conviene confirmarlo antes de salir."], ["¿Cuánto tiempo se necesita?", "Entre 30 y 60 minutos permiten observar la plaza con calma. Sume tiempo si desea recorrer otros hitos del centro histórico."], ["¿Hay estacionamiento y baños?", "La disponibilidad no es constante ni se recomienda un proveedor. Consulte opciones autorizadas y servicios disponibles al momento de llegar."], ["¿Qué idioma se usa en la zona?", "El español es la lengua de la información pública local. Esta guía también dispone de una versión en inglés para facilitar la planificación de visitantes internacionales."]], creditsTitle: "Créditos de imagen", creditText: "Fotografía nocturna de la plaza: Wasaberta, CC BY-SA 4.0, vía Wikimedia Commons.", readMore: "Conozca la fuente", cookieTitle: "Su elección de cookies", cookieText: "Puede gestionar las cookies necesarias y analíticas desde la página de ajustes.", cookieLink: "Ir a ajustes"
} : {
title: "Plaza de Armas de Cajamarca (Cajamarca) - Visitor Guide & Location", description: "Discover Plaza de Armas de Cajamarca, the iconic landmark in Cajamarca, Cajamarca, Peru. View location map, opening details, nearby Cajamarca Cathedral and Ransom Room, and travel tips.", eyebrow: "Historic centre · Cajamarca, Peru", hero: "A square where stone holds memory.", intro: "Welcome to **Plaza de Armas de Cajamarca**, widely recognized as the central **Plaza de Armas of Cajamarca**. Located in the heart of **Cajamarca**, **Cajamarca**, **Peru** (Plaza de Armas de Cajamarca → Cajamarca → Cajamarca → Peru), this destination serves as a primary hub for travelers visiting the region, offering historical context, practical orientation and respect for a living public space.", route: "Open map and route", source: "View public source", lead: "Before you go", tiles: [["Entry", "Free"], ["Published access reference", "24 hours"], ["Elevation", "2,722 m"], ["Map point", "-7.1565, -78.5199"]], photoCaption: "View of Plaza de Armas de Cajamarca. Photo: Josefito123, CC BY-SA 4.0, via Wikimedia Commons.", contextKicker: "A square to read on foot", contextTitle: "The shape of a square, the weight of a history (About Plaza de Armas de Cajamarca).", p1: "About Plaza de Armas de Cajamarca: it sits in Cajamarca’s historic centre, Cajamarca, Peru (Plaza de Armas de Cajamarca → Cajamarca → Cajamarca → Peru). The national tourism inventory classifies it as a cultural manifestation and historic place; it records a square plan, a net area of 12,139 m² and an elevation of 2,722 metres.", p2: "This space is linked to the 1532 encounter between the forces of Francisco Pizarro and the Inca Atahualpa. Its history deserves care: it is not a static backdrop, but an urban space holding Andean memory, the colonial period and present-day life.", p3: "At its centre stands the carved basin: an octagonal stone fountain that public sources date to the end of the 17th century. Notice its proportions, its relationship with the facades and the changing light before hurrying onward.", monument: "Heritage note", monumentText: "The fountain was declared a Historic Monument by a 1972 state resolution, according to the official inventory record.", portraitTitle: "Three cues for looking", observe: "Let the walk move slowly.", cues: [["01", "The fountain", "The octagonal basin visually organises the open centre."], ["02", "The edges", "Churches, facades and pedestrian paths frame the square’s perimeter."], ["03", "Everyday use", "This is a public space: give priority to people walking, resting and taking part in local activity."]], visitKicker: "Practical orientation", visitTitle: "Arrive, walk and cover the essentials (Location & How to visit Plaza de Armas of Cajamarca in Cajamarca).", visitIntro: "Plaza de Armas de Cajamarca is in the city centre of Cajamarca, Cajamarca, Peru. Traffic, stops, parking and service availability can change; confirm anything important on the day of your visit.", arrival: "Getting there", arrivals: [["From the airport", "After arriving at Cajamarca airport, an authorised taxi or pre-arranged transport can connect you with the urban centre. Ask the driver to confirm the drop-off point and traffic conditions before departure."], ["From the bus terminal or city", "Intercity buses arrive in town; from arrival areas, continue by taxi, urban transport or on foot depending on location, luggage and time. Do not cross busy streets with luggage except at suitable crossings."], ["By taxi or car", "Use “Plaza de Armas de Cajamarca” as your destination reference. Vehicle access requires attention to restrictions, pedestrians and temporary centre closures. No particular car park is listed because availability varies."], ["On foot", "The tourism inventory places the site in the city centre and lists pedestrian access as the immediate approach. Use well-lit routes, especially after dusk."]], fee: "Entry and costs", feeText: "MINCETUR’s public record lists free entry and a 24-hour access reference. The square is a public space and no admission charge is shown for walking through it. Transport, parking, purchases and private activities are arranged separately.", time: "Best time and length of visit", timeText: "For a comfortable walk and a clear view of facades, choose morning or late afternoon; adjust to the weather and local activity. Allow 30 to 60 minutes for the square, and more if you continue through the historic centre.", services: "Services around the square", serviceTitle: "Useful details, without turning the visit into advertising.", serviceIntro: "This guide describes service types rather than recommending businesses. The official inventory notes accommodation and food offerings in the square and city, as well as banks, taxis, everyday shops and city service stations.", serviceItems: [["Restrooms and water", "Ask about public facilities or customer services in nearby premises; availability and conditions of use may vary."], ["Parking", "Consider authorised options away from the roadway. Confirm hours, capacity and rules before leaving a vehicle."], ["Food", "The centre includes restaurants, cafés, kiosks and other food formats. Choose according to your needs and confirm allergens directly."], ["Rest and supplies", "The city offers hotels, hostels, neighbourhood shops and cash machines. Plan accommodation and use cash points only in secure locations."], ["Fuel and charging", "Service stations are found in the city, not within the square’s pedestrian experience. Check route and vehicle compatibility before travelling."], ["Accessibility", "Paving, edges and urban activity can affect mobility. If you need a specific accessibility condition, confirm through official channels before visiting."]], foodKicker: "Eating nearby, with care", foodTitle: "A guide to types, not brands.", foodText: "Cajamarca’s urban setting includes restaurants, cafés, kiosks and soda-fountain formats. To preserve editorial independence, this guide neither ranks nor promotes businesses. Look for a choice that suits your budget, diet and time, then confirm ingredients, payment methods and hours directly.", nearbyKicker: "Continue the walk", nearbyTitle: "Landmarks to connect with the square (Landmarks & Attractions Around Plaza de Armas of Cajamarca).", nearbyIntro: "When visiting Plaza de Armas de Cajamarca, visitors can easily explore surrounding historical landmarks and points of interest, including **Cajamarca Cathedral** and the **Ransom Room (Cuarto del Rescate)**.", nearby: [["Cajamarca Cathedral", "A church opposite the square and a central visual reference in the historic ensemble."], ["San Francisco Church", "Religious architecture that helps read the square’s urban edge."], ["Ransom Room", "A site historically associated with Atahualpa; confirm access conditions before going."], ["Santa Apolonia Hill", "An urban high point for viewing the city’s relationship with its landscape."], ["Baños del Inca", "An area known for thermal waters, beyond the square’s immediate walking circuit."]], mapKicker: "Location", mapTitle: "Place your visit in Cajamarca’s centre (Location & Map of Plaza de Armas de Cajamarca).", mapText: "The map is presented in Spanish, the local language of the area. Use it for orientation; for live route decisions, confirm traffic and access conditions in the mapping service.", mapLink: "Open location in Google Maps", mapGovNote: "For official updates and regional tourism information, visit the <a href=\"http://consultasenlinea.mincetur.gob.pe/fichaInventario/index.aspx?cod_Ficha=2432\" target=\"_blank\" rel=\"noopener noreferrer\">Peru / Cajamarca Official Tourism Portal of MINCETUR</a>.", faqKicker: "Frequently asked questions", faqTitle: "Short answers for careful planning (FAQ about Plaza de Armas de Cajamarca).", faqs: [["Is there an entrance fee for Plaza de Armas de Cajamarca?", "MINCETUR’s record lists free entry. It is a public square; private services around it are arranged separately."], ["Is it open all day?", "The public inventory lists a 24-hour access reference. Events, works, safety conditions and local changes may affect the visit, so confirm before leaving."], ["How long should I allow?", "Thirty to sixty minutes lets you take in the square calmly. Add time if you plan to see other landmarks in the historic centre."], ["Are parking and restrooms available?", "Availability is not constant and this guide does not recommend a provider. Ask about authorised parking and currently available facilities when you arrive."], ["What language is used locally?", "Spanish is the language of local public information. This guide also provides an English version to help international visitors plan."]], creditsTitle: "Image credits", creditText: "Night photograph of the square: Wasaberta, CC BY-SA 4.0, via Wikimedia Commons.", readMore: "Read the source", cookieTitle: "Your cookie choice", cookieText: "You can manage necessary and analytics cookies from the settings page.", cookieLink: "Go to settings"
};
const inventoryUrl = "http://consultasenlinea.mincetur.gob.pe/fichaInventario/index.aspx?cod_Ficha=2432";
