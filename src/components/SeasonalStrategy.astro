---
// Design reminder: Archivo de Piedra Viva — a seasonal table based on Cajamarca's highland climate
// pattern, with the December–February row corrected following IPERÚ Cajamarca guidance.
interface Props { lang: "es" | "en"; }
const { lang } = Astro.props;
const isSpanish = lang === "es";
const copy = isSpanish
  ? {
      kicker: "Cuándo ir",
      title: "Estrategia de visita por temporada",
      intro: "Cajamarca tiene clima de sierra: días templados por la altura y noches frías, con una estación seca y otra lluviosa. La tabla resume el patrón general; confirma el parte local antes de salir.",
      note: "Fuente del ajuste de diciembre a febrero: recomendaciones de revisión comunicadas por IPERÚ Cajamarca y firmadas por Cristhian Cruz Julcamoro, Asistente de la Dirección de Coordinación de Oficinas Regionales de PROMPERÚ (Comisión de Promoción del Perú para la Exportación y el Turismo). IPERÚ es su servicio oficial de Información y Asistencia al Turista. Se trata de orientación estacional cualitativa facilitada para esta guía, no de un índice de precipitaciones de la provincia de Cajamarca, mediciones meteorológicas ni garantía de lluvia diaria. Consulte el pronóstico y los avisos oficiales.",
      cols: ["Temporada", "Cielo y lluvia", "Para caminar y fotografiar", "Lleva", "Precaución"],
      rows: [
        ["Dic – Feb", "Lluvias frecuentes: IPERÚ Cajamarca señala que en años recientes las mayores precipitaciones se han concentrado entre diciembre y febrero.", "Deje margen para la lluvia y ajuste el paseo al pronóstico; no presuponga mañanas despejadas.", "Impermeable, calzado seco, una prenda de abrigo.", "Pavimento resbalizo y posibles interrupciones del paseo por lluvia."],
        ["Mar – May", "Las lluvias bajan; campo verde y aire limpio.", "Paisaje fresco y cielos despejados para fotos.", "Capa ligera, protector solar.", "Tramos de tierra húmedos en los alrededores."],
        ["Jun – Sep", "Estación seca: sol, cielos claros y noches frías.", "Elija el horario y la duración según el pronóstico.", "Abrigo térmico, gorro y guantes livianos.", "Heladas nocturnas; mañanas muy frías al amanecer."],
        ["Oct – Nov", "Transición: la lluvia regresa de a poco.", "Buen equilibrio de sol y nubes.", "Impermeable plegable, ropa en capas.", "Cambios rápidos de tiempo en la tarde."]
      ]
    }
  : {
      kicker: "When to go",
      title: "Seasonal visiting strategy",
      intro: "Cajamarca has a highland climate: mild days from the elevation and cold nights, with a dry season and a rainy season. The table summarises the general pattern; confirm the local forecast before you leave.",
      note: "Source of the December–February correction: review recommendations communicated by IPERÚ Cajamarca and signed by Cristhian Cruz Julcamoro, Assistant, Dirección de Coordinación de Oficinas Regionales, PROMPERÚ (Comisión de Promoción del Perú para la Exportación y el Turismo). IPERÚ is its official tourist information and assistance service. This is qualitative seasonal guidance supplied for this guide, not a Cajamarca province rainfall index, meteorological measurements or a guarantee of daily rain. Check the forecast and official alerts.",
      cols: ["Season", "Sky & rain", "For walking & photos", "Bring", "Caution"],
      rows: [
        ["Dec – Feb", "Frequent rain: IPERÚ Cajamarca says recent years’ heaviest rainfall has concentrated between December and February.", "Allow flexibility for rain and follow the forecast; do not assume clear mornings.", "Raincoat, dry footwear, a warm layer.", "Slippery paving and possible rain interruptions to your walk."],
        ["Mar – May", "Rain eases; green countryside and clear air.", "Fresh scenery and clear skies for photos.", "Light layer, sun protection.", "Damp dirt stretches on the outskirts."],
        ["Jun – Sep", "Dry season: sun, clear skies and cold nights.", "Best light and stability for photographing facades.", "Thermal wear, hat and light gloves.", "Night frosts; very cold dawns."],
        ["Oct – Nov", "Transition: rain returns gradually.", "A fair mix of sun and cloud.", "Packable raincoat, layered clothing.", "Quick afternoon changes in weather."]
      ]
    };
---
<section class="season-section" aria-labelledby="season-title">
  <div class="season-intro">
    <p class="eyebrow">{copy.kicker}</p>
    <h2 id="season-title">{copy.title}</h2>
    <p>{copy.intro}</p>
  </div>
  <div class="season-table-wrap">
    <table class="season-table">
      <thead><tr>{copy.cols.map((c) => <th>{c}</th>)}</tr></thead>
      <tbody>
        {copy.rows.map((r) => (
          <tr>
            <th scope="row">{r[0]}</th>
            {r.slice(1).map((cell) => <td>{cell}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="season-note">{copy.note} <a href="https://www.gob.pe/institucion/promperu/informes-publicaciones/5187391-directorio-iperu-oficinas-y-puntos-de-atencion" target="_blank" rel="noopener noreferrer">{isSpanish ? "Directorio institucional de IPERÚ / PROMPERÚ" : "IPERÚ / PROMPERÚ institutional directory"}</a></p>
</section>

<style>
  .season-section { max-width: 1280px; margin: 0 auto; padding: 118px 38px; border-top: 1px solid var(--line); }
  .season-intro .eyebrow { color: var(--terracotta-dark); }
  .season-intro h2 { font-family: var(--serif); font-size: clamp(43px, 4.5vw, 68px); font-weight: 600; letter-spacing: -.055em; line-height: .9; margin: 14px 0 18px; }
  .season-intro p { color: #514b42; font-size: 17px; max-width: 640px; }
  .season-table-wrap { margin-top: 44px; overflow-x: auto; border: 1px solid var(--line); background: var(--paper); }
  .season-table { width: 100%; border-collapse: collapse; min-width: 760px; }
  .season-table th, .season-table td { text-align: left; vertical-align: top; padding: 18px 20px; border-bottom: 1px solid var(--line); font-size: 14px; line-height: 1.5; }
  .season-table thead th { background: var(--stone); color: var(--terracotta-dark); font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .season-table tbody th[scope="row"] { color: var(--blue); font-family: var(--serif); font-size: 20px; font-weight: 700; letter-spacing: -.02em; white-space: nowrap; }
  .season-table tbody tr:last-child th, .season-table tbody tr:last-child td { border-bottom: 0; }
  .season-table td { color: #4e493f; }
  .season-note { margin: 22px 0 0; color: var(--muted); font-size: 12px; }
  @media (max-width: 900px) { .season-section { padding: 84px 27px; } }
</style>
