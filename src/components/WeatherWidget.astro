---
// Design reminder: Archivo de Piedra Viva — weather remains a precise field note, with the next three days presented as a compact observation ledger.
interface Props { lang: "es" | "en"; }
const { lang } = Astro.props;
const isSpanish = lang === "es";
const copy = isSpanish
  ? { eyebrow: "Condiciones actuales", title: "Tiempo en la plaza", loading: "Consultando condiciones actuales…", unavailable: "No se pudo consultar el tiempo ahora.", retry: "Actualizar", temperature: "Temperatura", feels: "Sensación", wind: "Viento", rain: "Precipitación", timestamp: "Modelo meteorológico · hora local de Cajamarca", source: "Fuente: Open-Meteo", forecastEyebrow: "Planificar la caminata", forecastTitle: "Próximos tres días", forecastLoading: "Preparando el pronóstico…", high: "máx.", low: "mín.", rainChance: "lluvia", visitTip: "Sugerencia de visita", clear: "Despejado", mostlyClear: "Mayormente despejado", partlyCloudy: "Parcialmente nublado", overcast: "Cubierto", fog: "Niebla", drizzle: "Llovizna", rainLabel: "Lluvia", snow: "Nieve", showers: "Chubascos", thunder: "Tormenta", dryTip: "Una mañana despejada o el final de la tarde suelen ser las franjas más cómodas para caminar.", dampTip: "Considere llevar protección ligera para la lluvia y ajustar el recorrido si aparecen chubascos.", coolTip: "Las mañanas pueden sentirse frescas por la altitud; una capa ligera ayuda al iniciar el paseo." }
  : { eyebrow: "Current conditions", title: "Weather at the square", loading: "Checking current conditions…", unavailable: "Weather could not be loaded right now.", retry: "Refresh", temperature: "Temperature", feels: "Feels like", wind: "Wind", rain: "Precipitation", timestamp: "Weather model · Cajamarca local time", source: "Source: Open-Meteo", forecastEyebrow: "Plan the walk", forecastTitle: "Next three days", forecastLoading: "Preparing the forecast…", high: "high", low: "low", rainChance: "rain", visitTip: "Visit note", clear: "Clear", mostlyClear: "Mostly clear", partlyCloudy: "Partly cloudy", overcast: "Overcast", fog: "Fog", drizzle: "Drizzle", rainLabel: "Rain", snow: "Snow", showers: "Showers", thunder: "Thunderstorm", dryTip: "A clear morning or late afternoon is usually the most comfortable time for a walk.", dampTip: "Consider light rain protection and adjust your walk if showers develop.", coolTip: "Mornings may feel cool at this elevation; a light layer helps when beginning the walk." };
---

<section class="weather-section" aria-labelledby="weather-title" data-weather-widget data-lang={lang} aria-busy="true">
  <div class="weather-copy"><p class="eyebrow">{copy.eyebrow}</p><h2 id="weather-title">{copy.title}</h2><span class="weather-arcade" aria-hidden="true"><i></i><i></i><i></i></span><p class="weather-status" data-weather-status aria-live="polite">{copy.loading}</p><a href="https://open-meteo.com/" target="_blank" rel="noreferrer">{copy.source} ↗</a></div>
  <div class="weather-reading" data-weather-reading hidden>
    <div class="weather-primary"><span class="weather-glyph" data-weather-glyph aria-hidden="true">○</span><div><strong data-weather-condition>—</strong><span data-weather-time>—</span></div></div>
    <dl class="weather-metrics"><div><dt>{copy.temperature}</dt><dd><span data-weather-temp>—</span><small>°C</small></dd></div><div><dt>{copy.feels}</dt><dd><span data-weather-feels>—</span><small>°C</small></dd></div><div><dt>{copy.wind}</dt><dd><span data-weather-wind>—</span><small>km/h</small></dd></div><div><dt>{copy.rain}</dt><dd><span data-weather-rain>—</span><small>mm</small></dd></div></dl>
  </div>
  <button class="weather-refresh" type="button" data-weather-refresh><span aria-hidden="true">↻</span><span>{copy.retry}</span></button>
  <div class="weather-forecast" data-weather-forecast hidden aria-live="polite"><div class="forecast-heading"><div><p class="eyebrow">{copy.forecastEyebrow}</p><h3>{copy.forecastTitle}</h3></div><p data-weather-tip data-forecast-ledger-label={isSpanish ? "NOTA" : "NOTE"}><strong>{copy.visitTip}.</strong> {copy.forecastLoading}</p></div><div class="forecast-days" data-weather-days></div></div>
</section>

<script is:inline>
  (() => {
    const labels = {
      es: { clear: "Despejado", mostlyClear: "Mayormente despejado", partlyCloudy: "Parcialmente nublado", overcast: "Cubierto", fog: "Niebla", drizzle: "Llovizna", rainLabel: "Lluvia", snow: "Nieve", showers: "Chubascos", thunder: "Tormenta", unavailable: "No se pudo consultar el tiempo ahora.", loading: "Consultando condiciones actuales…", timestamp: "Modelo meteorológico · hora local de Cajamarca", high: "máx.", low: "mín.", rainChance: "lluvia", visitTip: "Sugerencia de visita", dryTip: "Una mañana despejada o el final de la tarde suelen ser las franjas más cómodas para caminar.", dampTip: "Considere llevar protección ligera para la lluvia y ajustar el recorrido si aparecen chubascos.", coolTip: "Las mañanas pueden sentirse frescas por la altitud; una capa ligera ayuda al iniciar el paseo." },
      en: { clear: "Clear", mostlyClear: "Mostly clear", partlyCloudy: "Partly cloudy", overcast: "Overcast", fog: "Fog", drizzle: "Drizzle", rainLabel: "Rain", snow: "Snow", showers: "Showers", thunder: "Thunderstorm", unavailable: "Weather could not be loaded right now.", loading: "Checking current conditions…", timestamp: "Weather model · Cajamarca local time", high: "high", low: "low", rainChance: "rain", visitTip: "Visit note", dryTip: "A clear morning or late afternoon is usually the most comfortable time for a walk.", dampTip: "Consider light rain protection and adjust your walk if showers develop.", coolTip: "Mornings may feel cool at this elevation; a light layer helps when beginning the walk." }
    };
    const weatherCode = (code, words) => {
      if (code === 0) return [words.clear, "☼"];
      if (code <= 2) return [words.mostlyClear, "◔"];
      if (code === 3) return [words.partlyCloudy, "☁"];
      if (code <= 48) return [words.fog, "≋"];
      if (code <= 57) return [words.drizzle, "∶"];
      if (code <= 67) return [words.rainLabel, "☂"];
      if (code <= 77) return [words.snow, "✳"];
      if (code <= 82) return [words.showers, "☂"];
      return [words.thunder, "ϟ"];
    };
    const dateLabel = (date, lang) => new Intl.DateTimeFormat(lang === "es" ? "es-PE" : "en-GB", { weekday: "short", day: "numeric", month: "short", timeZone: "America/Lima" }).format(new Date(`${date}T12:00:00-05:00`));
    document.querySelectorAll("[data-weather-widget]").forEach((widget) => {
      const lang = widget.dataset.lang === "en" ? "en" : "es";
      const text = labels[lang];
      const status = widget.querySelector("[data-weather-status]");
      const reading = widget.querySelector("[data-weather-reading]");
      const forecast = widget.querySelector("[data-weather-forecast]");
      const days = widget.querySelector("[data-weather-days]");
      const tip = widget.querySelector("[data-weather-tip]");
      const refresh = widget.querySelector("[data-weather-refresh]");
      const renderCurrent = (current) => {
        const [condition, glyph] = weatherCode(current.weather_code, text);
        widget.querySelector("[data-weather-condition]").textContent = condition;
        widget.querySelector("[data-weather-glyph]").textContent = glyph;
        widget.querySelector("[data-weather-temp]").textContent = Math.round(current.temperature_2m);
        widget.querySelector("[data-weather-feels]").textContent = Math.round(current.apparent_temperature);
        widget.querySelector("[data-weather-wind]").textContent = Math.round(current.wind_speed_10m);
        widget.querySelector("[data-weather-rain]").textContent = Number(current.precipitation).toFixed(1);
        widget.querySelector("[data-weather-time]").textContent = `${text.timestamp} · ${current.time.replace("T", " · ")}`;
        reading.hidden = false;
      };
      const renderForecast = (daily) => {
        const dates = daily.time?.slice(0, 3) || [];
        const maxes = daily.temperature_2m_max || [];
        const mins = daily.temperature_2m_min || [];
        const rains = daily.precipitation_probability_max || [];
        const codes = daily.weather_code || [];
        if (!dates.length) return;
        days.innerHTML = dates.map((date, index) => {
          const [condition, glyph] = weatherCode(codes[index], text);
          return `<article class="forecast-day"><p>${dateLabel(date, lang)}</p><span aria-hidden="true">${glyph}</span><strong>${condition}</strong><dl><div><dt>${text.high}</dt><dd>${Math.round(maxes[index])}°</dd></div><div><dt>${text.low}</dt><dd>${Math.round(mins[index])}°</dd></div><div><dt>${text.rainChance}</dt><dd>${Math.round(rains[index] || 0)}%</dd></div></dl></article>`;
        }).join("");
        const highestRain = Math.max(...rains.map((value) => Number(value || 0)));
        const hasWetWeather = codes.some((code) => Number(code) >= 51);
        const lowestTemp = Math.min(...mins.map((value) => Number(value)));
        const message = highestRain >= 45 || hasWetWeather ? text.dampTip : lowestTemp < 8 ? text.coolTip : text.dryTip;
        tip.innerHTML = `<strong>${text.visitTip}.</strong> ${message}`;
        forecast.hidden = false;
      };
      const load = async () => {
        widget.setAttribute("aria-busy", "true");
        status.hidden = false;
        status.textContent = text.loading;
        refresh.disabled = true;
        try {
          const response = await fetch("/api/weather", { headers: { Accept: "application/json" } });
          if (!response.ok) throw new Error("weather request failed");
          const payload = await response.json();
          if (!payload.current || !payload.daily) throw new Error("missing weather data");
          renderCurrent(payload.current);
          renderForecast(payload.daily);
          status.hidden = true;
        } catch (error) {
          reading.hidden = true;
          forecast.hidden = true;
          status.hidden = false;
          status.textContent = text.unavailable;
        } finally {
          widget.setAttribute("aria-busy", "false");
          refresh.disabled = false;
        }
      };
      refresh.addEventListener("click", load);
      load();
    });
  })();
</script>

<style>
  .weather-section { display: grid; grid-template-columns: minmax(250px, .72fr) minmax(440px, 1.28fr) auto; gap: 38px; align-items: start; max-width: 1280px; margin: 0 auto; padding: 54px 38px 42px; background: linear-gradient(180deg, var(--stone) 0%, #fffaf0 100%); border-bottom: 1px solid var(--line); }
  .weather-copy { position: relative; padding-top: 6px; }.weather-copy .eyebrow { margin-bottom: 8px; }.weather-copy h2 { margin: 0; color: var(--blue); font-family: var(--serif); font-size: clamp(33px, 3.2vw, 46px); font-weight: 600; letter-spacing: -.045em; line-height: .9; }.weather-status { min-height: 1.4em; margin: 10px 0 2px; color: var(--muted); font-size: 13px; }.weather-copy > a { color: var(--terracotta-dark); font-size: 11px; font-weight: 700; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }.weather-arcade { display: flex; gap: 3px; position: absolute; top: 10px; right: 0; align-items: end; height: 23px; opacity: .8; }.weather-arcade i { display: block; width: 10px; height: 16px; border: 1px solid var(--terracotta); border-bottom: 0; border-radius: 10px 10px 0 0; }
  .weather-reading { display: grid; grid-template-columns: minmax(190px, .68fr) 1.32fr; align-items: center; min-width: 0; padding: 20px 22px; background: #fffaf0; border: 1px solid var(--line); border-radius: 4px; box-shadow: 0 10px 32px rgba(65,52,38,.06); }.weather-primary { display: flex; align-items: center; gap: 15px; padding-right: 22px; padding-top: 2px; padding-bottom: 2px; }.weather-glyph { display: grid; width: 55px; height: 55px; place-items: center; border: 1px solid var(--terracotta); border-radius: 50%; color: var(--terracotta-dark); font-family: var(--serif); font-size: 34px; line-height: 1; background: rgba(184,79,43,.05); }.weather-primary strong { display: block; color: var(--ink); font-family: var(--serif); font-size: 25px; font-weight: 600; line-height: 1; }.weather-primary span:last-child { display: block; max-width: 210px; margin-top: 7px; color: var(--muted); font-size: 10px; line-height: 1.4; }.weather-metrics { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; border-left: 1px solid var(--line); padding-left: 20px; }.weather-metrics div { min-width: 0; padding: 4px 4px 4px 12px; border-right: 1px solid var(--line); }.weather-metrics div:last-child { border: 0; }.weather-metrics dt,.forecast-day dt { color: var(--muted); font-size: 9px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }.weather-metrics dd { margin: 4px 0 0; color: var(--blue); font-family: var(--serif); font-size: 27px; font-weight: 700; letter-spacing: -.04em; line-height: 1; white-space: nowrap; }.weather-metrics small { margin-left: 1px; color: var(--terracotta-dark); font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0; }.weather-refresh { display: inline-flex; align-items: center; gap: 6px; padding: 9px 0 9px 13px; border: 0; border-left: 1px solid var(--line); background: transparent; color: var(--terracotta-dark); cursor: pointer; font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; transition: color .18s var(--ease), transform .18s var(--ease); margin-top: 18px; }.weather-refresh:hover { color: var(--blue); transform: translateY(-1px); }.weather-refresh:active { transform: scale(.97); }.weather-refresh:disabled { cursor: wait; opacity: .55; }.weather-refresh:disabled span:first-child { animation: spin .7s linear infinite; }
  .weather-forecast { grid-column: 1 / -1; position: relative; width: 100%; margin-top: 40px; padding: 30px 30px 0; border: 1px solid var(--line); border-radius: 5px; background: radial-gradient(1200px 300px at 10% -10%, rgba(63,80,110,.05), transparent 60%), radial-gradient(900px 220px at 95% 110%, rgba(184,79,43,.06), transparent 55%), repeating-linear-gradient(180deg, transparent 0 18px, rgba(36,35,31,.035) 18px 18.6px), rgba(255,250,240,.9); box-shadow: 0 14px 46px rgba(65,52,38,.08), inset 0 0 0 1px rgba(255,250,240,.6), inset 0 0 0 4px rgba(36,35,31,.035); counter-reset: forecast-index; }
  .weather-forecast::before { content: ""; position: absolute; inset: 6px; border: 1px dashed rgba(36,35,31,.14); border-radius: 4px; pointer-events: none; }
  .forecast-heading { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(220px, .62fr) minmax(320px, 1.38fr); gap: 30px; align-items: start; }
  .forecast-heading > div { position: relative; padding-left: 14px; }
  .forecast-heading > div::before { content: ""; position: absolute; left: 0; top: 3px; bottom: 6px; width: 3px; border-radius: 2px; background: linear-gradient(180deg, var(--terracotta) 0%, rgba(184,79,43,.2) 100%); }
  .forecast-heading .eyebrow { position: relative; display: inline-flex; align-items: center; gap: 6px; margin: 0 0 7px; padding: 2px 9px 3px; border: 1px solid rgba(184,79,43,.35); border-radius: 2px; background: rgba(184,79,43,.06); font-size: 10px; }
  .forecast-heading .eyebrow::before { content: "№"; display: inline-block; color: var(--terracotta-dark); font-family: var(--serif); font-weight: 700; }
  .forecast-heading h3 { margin: 0; color: var(--blue); font-family: var(--serif); font-size: 30px; font-weight: 600; letter-spacing: -.04em; line-height: .95; }
  .forecast-heading > p { position: relative; z-index: 1; max-width: none; margin: 0; padding: 16px 20px 15px 54px; border: 1px solid rgba(184,79,43,.28); border-radius: 3px; color: #4c463c; font-size: 13.5px; line-height: 1.55; background: linear-gradient(90deg, rgba(184,79,43,.09) 0%, rgba(184,79,43,.03) 50%, rgba(184,79,43,.02) 100%), repeating-linear-gradient(0deg, transparent 0 22px, rgba(184,79,43,.06) 22px 22.3px); box-shadow: inset 0 1px 0 rgba(255,255,255,.65); }
  .forecast-heading > p::before { content: attr(data-forecast-ledger-label); position: absolute; left: 14px; top: 16px; display: inline-grid; place-items: center; min-width: 30px; height: 20px; padding: 0 7px; border-radius: 2px; background: var(--terracotta); color: #fffaf0; font-family: var(--sans); font-size: 9.5px; font-weight: 800; letter-spacing: .14em; box-shadow: 0 3px 8px rgba(184,79,43,.25); }
  .forecast-heading strong { color: var(--ink); font-weight: 700; }
  .forecast-days { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 26px; padding-bottom: 28px; }
  .forecast-day { position: relative; display: grid; grid-template-columns: 46px 1fr; grid-template-rows: auto auto auto; column-gap: 14px; padding: 20px 20px 22px 52px; border: 1px solid var(--line); border-top: 2px solid var(--terracotta); border-radius: 4px; background: linear-gradient(180deg, rgba(255,255,255,.8) 0%, rgba(255,250,240,.85) 100%); box-shadow: 0 10px 26px rgba(65,52,38,.07), inset 0 1px 0 rgba(255,255,255,.75), inset 0 0 0 1px rgba(255,255,255,.45); counter-increment: forecast-index; transition: transform .22s var(--ease), box-shadow .22s var(--ease), border-top-color .22s var(--ease), background .22s var(--ease); }
  .forecast-day::before { content: counter(forecast-index, decimal-leading-zero); position: absolute; left: 18px; top: 18px; display: grid; width: 26px; height: 26px; place-items: center; border: 1px solid rgba(36,35,31,.14); border-radius: 50%; color: var(--ink); font-family: var(--serif); font-size: 12px; font-weight: 700; background: rgba(255,250,240,.9); box-shadow: inset 0 0 0 3px rgba(255,255,255,.8), 0 2px 5px rgba(65,52,38,.08); }
  .forecast-day::after { content: ""; position: absolute; left: 52px; right: 20px; top: 51px; border-top: 1px dashed rgba(36,35,31,.13); pointer-events: none; }
  .forecast-day:hover { transform: translateY(-2px); border-top-color: var(--blue); background: linear-gradient(180deg, rgba(255,255,255,.95) 0%, rgba(251,243,226,.92) 100%); box-shadow: 0 18px 40px rgba(63,80,110,.12), inset 0 1px 0 rgba(255,255,255,.88); }
  .forecast-day > p { position: relative; z-index: 1; grid-column: 1 / -1; margin: 0 0 18px; padding-left: 2px; color: var(--terracotta-dark); font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .forecast-day > span { position: relative; z-index: 1; display: grid; grid-row: 2 / span 2; width: 42px; height: 42px; place-items: center; border: 1px solid var(--terracotta); border-radius: 50%; color: var(--terracotta-dark); font-family: var(--serif); font-size: 22px; background: radial-gradient(circle at 30% 30%, rgba(255,255,255,.8), rgba(255,255,255,0) 55%), repeating-radial-gradient(circle at 50% 50%, rgba(184,79,43,.08) 0 1px, transparent 1px 3px), rgba(184,79,43,.08); box-shadow: inset 0 0 0 1px rgba(255,250,240,.8), 0 4px 10px rgba(184,79,43,.16); }
  .forecast-day > strong { position: relative; z-index: 1; align-self: end; padding-bottom: 2px; color: var(--ink); font-family: var(--serif); font-size: 20px; font-weight: 600; letter-spacing: -.03em; line-height: 1.1; }
  .forecast-day dl { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; margin: 14px 0 0; padding: 12px 0 2px; border-top: 1px solid rgba(36,35,31,.14); border-bottom: 1px dashed rgba(36,35,31,.1); }
  .forecast-day dl > div { position: relative; display: flex; flex-direction: column; gap: 3px; padding: 0 10px; }
  .forecast-day dl > div + div::before { content: ""; position: absolute; left: 0; top: 2px; bottom: 2px; border-left: 1px dashed rgba(36,35,31,.12); }
  .forecast-day dt { color: #776e61; font-size: 8.8px; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
  .forecast-day dd { display: flex; align-items: baseline; gap: 4px; margin: 0; font-family: var(--serif); font-size: 20px; font-weight: 700; letter-spacing: -.04em; line-height: 1; }
  .forecast-day dl > div:nth-child(1) dd { color: var(--terracotta-dark); }
  .forecast-day dl > div:nth-child(2) dd { color: var(--blue); }
  .forecast-day dl > div:nth-child(3) dd { color: #3b7689; }
  .forecast-day dl > div:nth-child(3) dd::before { content: ""; display: inline-block; width: 7px; height: 9px; margin-right: 2px; border-radius: 0 0 4px 4px / 0 0 6px 6px; background: linear-gradient(180deg, #6fb0c4 0%, #3b7689 100%); transform: translateY(1px); clip-path: polygon(50% 0, 100% 38%, 100% 100%, 0 100%, 0 38%); }
  @keyframes spin { to { transform: rotate(1turn); } } @media (max-width: 1000px) { .weather-section { grid-template-columns: 1fr auto; gap: 25px; padding: 48px 28px 36px; }.weather-reading,.weather-forecast { grid-column: 1 / -1; }.weather-forecast { margin-top: 34px; padding: 26px 24px 0; }.forecast-heading { grid-template-columns: 1fr; gap: 18px; }.forecast-heading > div { padding-left: 12px; }.forecast-heading > p { padding: 14px 18px 14px 54px; }.forecast-heading > p::before { left: 14px; top: 13px; } } @media (max-width: 620px) { .weather-section { display: block; padding: 36px 25px 28px; }.weather-reading { display: block; margin-top: 25px; padding: 18px 16px; }.weather-primary { padding: 0 0 16px; }.weather-metrics { border-top: 1px solid var(--line); border-left: 0; padding-left: 0; padding-top: 14px; margin-top: 16px; }.weather-metrics div { padding: 6px 8px 4px 0; }.weather-refresh { position: absolute; right: 25px; margin-top: -38px; border-left: 0; padding-left: 0; }.weather-arcade { right: 64px; }.weather-forecast { margin-top: 32px; padding: 22px 18px 0; }.forecast-heading { grid-template-columns: 1fr; gap: 16px; }.forecast-heading > p { padding: 14px 16px 14px 54px; }.forecast-heading > p::before { left: 14px; top: 13px; }.forecast-days { grid-template-columns: 1fr; gap: 14px; padding-bottom: 22px; }.forecast-day { grid-template-columns: 42px 1fr; column-gap: 12px; padding: 18px 16px 20px 50px; border-right: 1px solid var(--line); border-bottom: 0; }.forecast-day::before { left: 16px; top: 16px; }.forecast-day::after { left: 50px; right: 16px; top: 48px; }.forecast-day > span { width: 38px; height: 38px; font-size: 20px; }.forecast-day > strong { font-size: 18.5px; }.forecast-day dd { font-size: 18px; }.forecast-heading > p { max-width: none; } }
</style>
