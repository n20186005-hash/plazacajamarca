---
// Design reminder: Archivo de Piedra Viva — a quiet, neutral weather panel. The visitor only cares
// "will it rain / what to wear". The data source is never surfaced. Risk notes are DERIVED from the
// forecast (thunderstorm / heavy rain / strong wind / fog), never presented as official alerts.
interface Props { lang: "es" | "en"; }
const { lang } = Astro.props;
const isSpanish = lang === "es";
const copy = isSpanish
  ? {
      kicker: "Cielo de Cajamarca ahora",
      title: "Clima en la plaza",
      intro: "Condiciones actuales y pronóstico a 7 días para la Plaza de Armas de Cajamarca, a 2.722 m de altitud. El pronóstico se actualiza con frecuencia.",
      now: "Ahora",
      feels: "Sensación",
      wind: "Viento",
      humidity: "Humedad",
      rain: "Prob. lluvia",
      uv: "UV",
      advice: "Consejo para tu visita",
      updated: "Actualizado",
      loading: "Consultando el clima…",
      unavailable: "El pronóstico no está disponible en este momento.",
      retry: "Reintentar",
      riskLabel: "Riesgo",
      outfitLabel: "Cómo vestir",
      playLabel: "Qué hacer",
      itemsLabel: "Lleva"
    }
  : {
      kicker: "Cajamarca sky right now",
      title: "Weather at the square",
      intro: "Current conditions and a 7-day forecast for Plaza de Armas de Cajamarca, at 2,722 m elevation. The forecast refreshes often.",
      now: "Now",
      feels: "Feels like",
      wind: "Wind",
      humidity: "Humidity",
      rain: "Rain chance",
      uv: "UV",
      advice: "Tip for your visit",
      updated: "Updated",
      loading: "Checking the weather…",
      unavailable: "The forecast is not available right now.",
      retry: "Retry",
      riskLabel: "Risk",
      outfitLabel: "What to wear",
      playLabel: "What to do",
      itemsLabel: "Bring"
    };
---
<section class="weather-section" id="clima" aria-labelledby="weather-title">
  <div class="weather-intro">
    <p class="eyebrow">{copy.kicker}</p>
    <h2 id="weather-title">{copy.title}</h2>
    <p>{copy.intro}</p>
  </div>
  <div class="weather-panel" data-weather data-lang={lang}>
    <div class="weather-status" data-weather-status>{copy.loading}</div>
    <div class="weather-body" data-weather-body hidden>
      <div class="current" data-current></div>
      <ul class="forecast" data-forecast></ul>
      <div class="advice" data-advice>
        <p class="advice-risk" data-risk hidden></p>
        <div class="advice-block" data-block-outfit hidden><h4 data-outfit-label></h4><ul data-outfit></ul></div>
        <div class="advice-block" data-block-play hidden><h4 data-play-label></h4><ul data-play></ul></div>
        <div class="advice-block" data-block-items hidden><h4 data-items-label></h4><ul data-items></ul></div>
      </div>
      <p class="updated" data-updated></p>
    </div>
  </div>
</section>

<style>
  .weather-section { display: grid; grid-template-columns: .82fr 1.18fr; gap: 60px; align-items: center; max-width: 1280px; margin: 0 auto; padding: 118px 38px; border-top: 1px solid var(--line); }
  .weather-intro .eyebrow { color: var(--terracotta-dark); }
  .weather-intro h2 { font-family: var(--serif); font-size: clamp(43px, 4.5vw, 68px); font-weight: 600; letter-spacing: -.055em; line-height: .9; margin: 14px 0 0; }
  .weather-intro p { margin-top: 22px; color: #514b42; font-size: 16px; max-width: 420px; }
  .weather-panel { background: var(--stone); border-top: 3px solid var(--terracotta); padding: 34px 36px; box-shadow: 0 14px 42px rgba(65, 52, 38, .08); }
  .weather-status { color: var(--muted); font-size: 15px; }
  .current { display: grid; grid-template-columns: auto 1fr; gap: 18px 24px; align-items: center; }
  .current .icon { font-size: 54px; line-height: 1; }
  .current .temp { font-family: var(--serif); font-size: 58px; font-weight: 600; letter-spacing: -.04em; line-height: .9; }
  .current .cond { font-size: 16px; color: var(--ink); }
  .current .meta { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(auto-fit, minmax(78px, 1fr)); gap: 14px 18px; margin-top: 8px; border-top: 1px solid var(--line); padding-top: 18px; }
  .current .meta div { font-size: 11px; color: var(--muted); line-height: 1.3; }
  .current .meta strong { display: block; color: var(--blue); font-family: var(--serif); font-size: 19px; font-weight: 700; letter-spacing: -.02em; margin-top: 3px; }
  .forecast { list-style: none; margin: 26px 0 0; padding: 22px 0 0; border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(auto-fit, minmax(82px, 1fr)); gap: 12px; }
  .forecast li { text-align: center; }
  .forecast .day { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--terracotta-dark); }
  .forecast .ficon { font-size: 26px; margin: 8px 0 4px; }
  .forecast .ftemp { font-family: var(--serif); font-size: 17px; font-weight: 600; }
  .forecast .frain { font-size: 11px; color: var(--muted); }
  .advice { margin: 24px 0 0; display: grid; gap: 12px; }
  .advice-risk { margin: 0; padding: 14px 16px; background: #5c1a13; color: #ffe9e3; font-size: 15px; line-height: 1.5; font-weight: 600; }
  .advice-risk::before { content: "⚠ " attr(data-label) " — "; font-weight: 700; }
  .advice-block { background: rgba(184, 79, 43, .07); border-left: 3px solid var(--terracotta); padding: 14px 16px; }
  .advice-block h4 { margin: 0 0 8px; font-size: 10px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; color: var(--terracotta-dark); }
  .advice-block ul { margin: 0; padding-left: 18px; color: var(--ink); font-size: 14px; line-height: 1.55; }
  .updated { margin: 16px 0 0; color: var(--muted); font-size: 11px; }
  .retry { margin-top: 14px; }
  .retry button { border: 0; background: var(--terracotta); color: #fffaf0; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding: 10px 14px; cursor: pointer; transition: background .16s var(--ease); }
  .retry button:hover { background: var(--terracotta-dark); }
  @media (max-width: 900px) { .weather-section { grid-template-columns: 1fr; gap: 30px; padding: 84px 27px; } }
</style>

<script>
  const panels = document.querySelectorAll<HTMLElement>("[data-weather]");
  if (panels.length) {
    const wmo: Record<number, { es: string; en: string; icon: string }> = {
      0: { es: "Despejado", en: "Clear", icon: "☀️" },
      1: { es: "Mayormente despejado", en: "Mainly clear", icon: "🌤️" },
      2: { es: "Parcialmente nublado", en: "Partly cloudy", icon: "⛅" },
      3: { es: "Nublado", en: "Overcast", icon: "☁️" },
      45: { es: "Niebla", en: "Fog", icon: "🌫️" },
      48: { es: "Niebla engelante", en: "Rime fog", icon: "🌫️" },
      51: { es: "Llovizna débil", en: "Light drizzle", icon: "🌦️" },
      53: { es: "Llovizna", en: "Drizzle", icon: "🌦️" },
      55: { es: "Llovizna intensa", en: "Dense drizzle", icon: "🌦️" },
      56: { es: "Llovizna helada", en: "Freezing drizzle", icon: "🌧️" },
      57: { es: "Llovizna helada", en: "Freezing drizzle", icon: "🌧️" },
      61: { es: "Lluvia débil", en: "Light rain", icon: "🌦️" },
      63: { es: "Lluvia", en: "Rain", icon: "🌧️" },
      65: { es: "Lluvia intensa", en: "Heavy rain", icon: "🌧️" },
      66: { es: "Lluvia helada", en: "Freezing rain", icon: "🌧️" },
      67: { es: "Lluvia helada", en: "Freezing rain", icon: "🌧️" },
      71: { es: "Nieve débil", en: "Light snow", icon: "🌨️" },
      73: { es: "Nieve", en: "Snow", icon: "🌨️" },
      75: { es: "Nieve intensa", en: "Heavy snow", icon: "🌨️" },
      77: { es: "Granizo menudo", en: "Snow grains", icon: "🌨️" },
      80: { es: "Chubascos", en: "Showers", icon: "🌦️" },
      81: { es: "Chubascos", en: "Showers", icon: "🌧️" },
      82: { es: "Chubascos fuertes", en: "Violent showers", icon: "⛈️" },
      85: { es: "Chubascos de nieve", en: "Snow showers", icon: "🌨️" },
      86: { es: "Chubascos de nieve", en: "Snow showers", icon: "🌨️" },
      95: { es: "Tormenta", en: "Thunderstorm", icon: "⛈️" },
      96: { es: "Tormenta con granizo", en: "Thunderstorm w/ hail", icon: "⛈️" },
      99: { es: "Tormenta con granizo", en: "Thunderstorm w/ hail", icon: "⛈️" }
    };
    const label = (code: number, l: "es" | "en") => wmo[code]?.[l] ?? (l === "es" ? "Cielo variable" : "Variable sky");
    const icon = (code: number) => wmo[code]?.icon ?? "🌥️";

    const beaufort = (kmh = 0) => {
      const s = [1, 5, 11, 19, 28, 38, 49, 61, 74, 88, 102, 117];
      let b = 0;
      while (b < s.length && kmh > s[b]) b++;
      return b;
    };
    const rainType = (code: number): "none" | "light" | "mod" | "heavy" | "snow" | "fog" | "thunder" => {
      if ([45, 48].includes(code)) return "fog";
      if ([95, 96, 99].includes(code)) return "thunder";
      if ([65, 82].includes(code)) return "heavy";
      if ([63, 66, 67, 71, 73, 75, 77, 81, 85, 86].includes(code)) return code >= 71 ? "snow" : "mod";
      if ([51, 53, 55, 56, 57, 61, 80].includes(code)) return "light";
      return "none";
    };

    panels.forEach((panel) => {
      const lang = panel.dataset.lang === "en" ? "en" : "es";
      const statusEl = panel.querySelector<HTMLElement>("[data-weather-status]")!;
      const bodyEl = panel.querySelector<HTMLElement>("[data-weather-body]")!;
      const currentEl = panel.querySelector<HTMLElement>("[data-current]")!;
      const forecastEl = panel.querySelector<HTMLElement>("[data-forecast]")!;
      const riskEl = panel.querySelector<HTMLElement>("[data-risk]")!;
      const outfitWrap = panel.querySelector<HTMLElement>("[data-block-outfit]")!;
      const playWrap = panel.querySelector<HTMLElement>("[data-block-play]")!;
      const itemsWrap = panel.querySelector<HTMLElement>("[data-block-items]")!;
      const outfitEl = panel.querySelector<HTMLElement>("[data-outfit]")!;
      const playEl = panel.querySelector<HTMLElement>("[data-play]")!;
      const itemsEl = panel.querySelector<HTMLElement>("[data-items]")!;
      const updatedEl = panel.querySelector<HTMLElement>("[data-updated]")!;

      const T = (es: string, en: string) => (lang === "es" ? es : en);
      const loadingText = T("Consultando el clima…", "Checking the weather…");
      const unavailableText = T("El pronóstico no está disponible en este momento.", "The forecast is not available right now.");
      const retryText = T("Reintentar", "Retry");
      const windWord = T("Fuerza", "Force");
      const nowText = T("Ahora", "Now");
      const feelsText = T("Sensación", "Feels like");
      const windText = T("Viento", "Wind");
      const humidityText = T("Humedad", "Humidity");
      const rainText = T("Prob. lluvia", "Rain chance");
      const uvText = T("UV", "UV");
      const updatedText = T("Actualizado", "Updated");

      const dayName = (iso: string, i: number) => {
        if (i === 0) return T("Hoy", "Today");
        if (i === 1) return T("Mañana", "Tomorrow");
        const d = new Date(iso + "T00:00:00");
        return d.toLocaleDateString(lang === "es" ? "es-PE" : "en-US", { weekday: "short", timeZone: "America/Lima" });
      };
      const windKmh = (v?: number) => (v == null ? "—" : `${Math.round(v)} km/h`);
      const pct = (v?: number) => (v == null ? "—" : `${Math.round(v)}%`);

      // Phrase library keyed by stable ids, resolved per language.
      const P: Record<string, string> = {
        pProb: T("Probable lluvia: lleva paraguas o impermeable.", "Rain likely: bring an umbrella or raincoat."),
        pPlay: T("Prioriza espacios cubiertos; deja los planes al aire libre con flexibilidad.", "Prefer covered spots; keep outdoor plans flexible."),
        pItems: T("Paraguas / impermeable", "Umbrella / raincoat"),
        lightPlay: T("Las zonas abiertas se disfrutan menos; camina con cuidado, el piso puede estar resbaloso.", "Open areas are less pleasant; walk carefully, pavements may be slippery."),
        lightItems: T("Paraguas plegable", "Foldable umbrella"),
        snowItems: T("Calzado antideslizante y abrigo", "Non-slip shoes and warm layer"),
        heavyRisk: T("Lluvia fuerte: evita quebradas y zonas bajas; el teleférico o paseos en bote pueden suspenderse.", "Heavy rain: avoid ravines and low ground; cable car or boat rides may stop."),
        heavyItems: T("Impermeable; mejor evita el paraguas de mango largo (viento).", "Raincoat; avoid long umbrellas (wind)."),
        thunderRisk: T("Riesgo de rayos: no subas cerros ni te resguardes bajo árboles; las actividades acuáticas suelen cerrar.", "Lightning risk: no climbing, no shelter under trees; water activities likely close."),
        hotOutfit: T("Hace calor: evita salir al mediodía.", "Hot: avoid going out at midday."),
        hotPlay: T("Acorta el tiempo al aire libre.", "Shorten outdoor time."),
        hotItems: T("Protector solar, bastante agua, algo para el calor", "Sun protection, plenty of water, heat relief"),
        uvOutfit: T("UV fuerte: protégete la piel.", "Strong UV: protect your skin."),
        uvItems: T("Bloqueador, lentes de sol, gorra", "Sunscreen, sunglasses, sun hat"),
        diffOutfit: T("Gran diferencia día/noche: lleva una prenda para abrigarte y quitarte.", "Big day-night swing: bring a layer you can add or remove."),
        coldOutfit: T("Hace frío: abrígate bien.", "Cold: dress warmly."),
        coldItems: T("Abrigo grueso, bufanda", "Warm coat, scarf"),
        feelOutfit: T("A la altura se siente frío: viste en capas térmicas.", "At altitude it feels cold: wear warm layers."),
        windOutfit: T("Viento notable.", "Breezy."),
        windPlay: T("El viento puede afectar actividades en zonas altas o abiertas.", "Wind may affect high or open-air activities."),
        windItems: T("La gorra se puede volar; evita faldas anchas.", "Hats may blow off; avoid loose long skirts."),
        windRisk: T("Viento fuerte: aléjate de carteles y bordes altos; las actividades al aire libre suelen cerrar.", "Strong wind: stay from signs and edges; outdoor activities likely close."),
        clearOutfit: T("Buen clima para salir.", "Fine weather to go out."),
        clearPlay: T("Ideal para ver amaneceres y atardeceres.", "Great for sunrise and sunset views."),
        clearItems: T("No olvides el protector solar.", "Remember sun protection."),
        partPlay: T("Luz suave, muy buena para fotografiar.", "Soft light, great for photos."),
        overPlay: T("Sin sol fuerte, bueno para caminar rato.", "No harsh sun, good for long walks."),
        fogRisk: T("Poca visibilidad: no es buen momento para miradores lejanos; lleva mascarilla si la hay.", "Poor visibility: not good for distant viewpoints; bring a mask if needed."),
        calmOutfit: T("Tiempo estable: viaja con tu rutina.", "Settled weather: travel as usual."),
        calmPlay: T("Buen momento para recorrer la plaza y alrededores.", "Good time to walk the square and nearby spots.")
      };

      const adviceFor = (d: any) => {
        const cur = d.current ?? {};
        const daily = d.daily ?? {};
        const code = cur.weather_code ?? 3;
        const tMax = (daily.temperature_2m_max ?? [])[0];
        const tMin = (daily.temperature_2m_min ?? [])[0];
        const tApp = cur.apparent_temperature;
        const prob = (daily.precipitation_probability_max ?? [])[0];
        const uv = (daily.uv_index_max ?? [])[0];
        const wind = cur.wind_speed_10m ?? 0;
        const b = beaufort(wind);
        const rt = rainType(code);

        const risk = new Set<string>();
        const outfit = new Set<string>();
        const play = new Set<string>();
        const items = new Set<string>();

        // 1) Derived risk (highest priority, weather-based — never an official alert)
        if (rt === "thunder") risk.add(P.thunderRisk);
        if (rt === "heavy") risk.add(P.heavyRisk);
        if (rt === "fog") risk.add(P.fogRisk);
        if (b >= 7) risk.add(P.windRisk);

        // 2) Travel outfit
        if (tMax != null && tMax <= 12) { outfit.add(P.coldOutfit); items.add(P.coldItems); }
        else if (tApp != null && tApp < 13) outfit.add(P.feelOutfit);
        if (tMax != null && tMin != null && tMax - tMin > 8) outfit.add(P.diffOutfit);
        if (tMax != null && tMax >= 32) outfit.add(P.hotOutfit);
        if (uv != null && uv >= 5) outfit.add(P.uvOutfit);
        if (b >= 5 && b <= 6) outfit.add(P.windOutfit);
        if (rt === "none" && code === 0 && outfit.size === 0) outfit.add(P.clearOutfit);

        // 3) Play plan
        if (prob != null && prob >= 60) play.add(P.pPlay);
        if (rt === "light") play.add(P.lightPlay);
        if (code === 0) play.add(P.clearPlay);
        else if (code === 1 || code === 2) play.add(P.partPlay);
        else if (code === 3) play.add(P.overPlay);
        if (tMax != null && tMax >= 32) play.add(P.hotPlay);
        if (b >= 5 && b <= 6) play.add(P.windPlay);
        if (play.size === 0) play.add(P.calmPlay);

        // 4) Items to bring
        if (prob != null && prob >= 60) items.add(P.pItems);
        if (rt === "light") items.add(P.lightItems);
        if (rt === "heavy") items.add(P.heavyItems);
        if (rt === "snow") items.add(P.snowItems);
        if (uv != null && uv >= 5) items.add(P.uvItems);
        if (tMax != null && tMax >= 32) items.add(P.hotItems);
        if (tMax != null && tMax <= 12) items.add(P.coldItems);
        if (b >= 5 && b <= 6) items.add(P.windItems);
        if (code === 0) items.add(P.clearItems);

        // Fallback so the panel is never empty when calm
        if (outfit.size === 0) outfit.add(P.calmOutfit);

        return { risk: [...risk], outfit: [...outfit], play: [...play], items: [...items] };
      };

      const render = (d: any) => {
        statusEl.hidden = true;
        bodyEl.hidden = false;
        const cur = d.current ?? {};
        const code = cur.weather_code ?? 3;
        const b = beaufort(cur.wind_speed_10m);
        const uv = (d.daily?.uv_index_max ?? [])[0];
        const meta = [
          [feelsText, cur.apparent_temperature != null ? Math.round(cur.apparent_temperature) + "°" : "—"],
          [windText, `${windWord} ${b} · ${windKmh(cur.wind_speed_10m)}`],
          [humidityText, pct(cur.relative_humidity_2m)],
          [rainText, pct((d.daily?.precipitation_probability_max ?? [])[0])],
          [uvText, uv != null ? Math.round(uv) : "—"]
        ];
        currentEl.innerHTML =
          `<div class="icon">${icon(code)}</div>` +
          `<div><div class="temp">${cur.temperature_2m != null ? Math.round(cur.temperature_2m) + "°" : "—"}</div>` +
          `<div class="cond">${label(code, lang)}</div></div>` +
          `<div class="meta">${meta.map(([k, v]) => `<div>${k}<strong>${v}</strong></div>`).join("")}</div>`;

        const times: string[] = d.daily?.time ?? [];
        forecastEl.innerHTML = times
          .map((iso, i) => {
            const c = (d.daily.weather_code ?? [])[i] ?? 3;
            const hi = (d.daily.temperature_2m_max ?? [])[i];
            const lo = (d.daily.temperature_2m_min ?? [])[i];
            const rp = (d.daily.precipitation_probability_max ?? [])[i];
            return (
              `<li><div class="day">${dayName(iso, i)}</div>` +
              `<div class="ficon">${icon(c)}</div>` +
              `<div class="ftemp">${hi != null ? Math.round(hi) + "°" : "—"}${lo != null ? " / " + Math.round(lo) + "°" : ""}</div>` +
              `<div class="frain">${pct(rp)}</div></li>`
            );
          })
          .join("");

        const a = adviceFor(d);
        const fill = (wrap: HTMLElement, list: HTMLElement, arr: string[]) => {
          if (arr.length) { wrap.hidden = false; list.innerHTML = arr.map((t) => `<li>${t}</li>`).join(""); }
          else wrap.hidden = true;
        };
        riskEl.dataset.label = copy.riskLabel;
        if (a.risk.length) { riskEl.hidden = false; riskEl.textContent = a.risk.join(" "); }
        else riskEl.hidden = true;
        (panel.querySelector("[data-outfit-label]") as HTMLElement).textContent = copy.outfitLabel;
        (panel.querySelector("[data-play-label]") as HTMLElement).textContent = copy.playLabel;
        (panel.querySelector("[data-items-label]") as HTMLElement).textContent = copy.itemsLabel;
        fill(outfitWrap, outfitEl, a.outfit);
        fill(playWrap, playEl, a.play);
        fill(itemsWrap, itemsEl, a.items);

        const t = (d.current?.time ?? "").replace("T", " ").slice(0, 16);
        updatedEl.textContent = `${updatedText}: ${t} (America/Lima)`;
      };

      const showError = () => {
        statusEl.hidden = false;
        statusEl.innerHTML = `${unavailableText} <span class="retry"><button type="button" data-retry>${retryText}</button></span>`;
        bodyEl.hidden = true;
        statusEl.querySelector("[data-retry]")?.addEventListener("click", load);
      };

      async function load() {
        statusEl.hidden = false;
        statusEl.textContent = loadingText;
        bodyEl.hidden = true;
        try {
          const res = await fetch("/api/weather");
          if (!res.ok) throw new Error("bad");
          const d = await res.json();
          if (d.error) throw new Error("err");
          render(d);
        } catch {
          showError();
        }
      }

      load();
    });
  }
</script>
