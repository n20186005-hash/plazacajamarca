{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cajamarca-plaza-guide",
  "main": "./src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_date": "2026-08-27"
}
